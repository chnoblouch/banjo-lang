# test:section input

struct @Vec3 {
    f32 @x
    f32 @y
    f32 @z
}

func void @use(addr)

func i32 @test() {
    %0 = alloca @Vec3
    %1 = memberptr @Vec3, addr %0, void 1
    store f32 5.0, addr %1
    %2 = memberptr @Vec3, addr %0, void 1
    %3 = load f32, addr %2
    call void @use, addr %0
    ret i32 %3
}

# test:section output

struct @Vec3 {
    f32 @x
    f32 @y
    f32 @z
}

func void @use(addr)

func i32 @test() {
    %0 = alloca @Vec3
    %1 = memberptr @Vec3, addr %0, void 1
    store f32 5.0, addr %1
    %2 = memberptr @Vec3, addr %0, void 1
    %3 = load f32, addr %2
    call void @use, addr %0
    ret i32 %3
}
