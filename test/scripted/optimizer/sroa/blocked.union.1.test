# test:pass "sroa"
# test:section input

struct @A {
    i64 @f0
    i32 @f1
    i32 @f1
}

struct @B {
    i64 @f0
    i32 @f1
    f32 @f2
}

struct @S {
    @A @a
    @B @b
}

func f32 @test() {
    %0 = alloca @S
    %1 = memberptr @A, addr %0, void 2
    store i64 100, addr %0
    %2 = memberptr @B, addr %0, void 2
    %3 = load f32, addr %0
    ret f32 %3
}

# test:section output

struct @A {
    i64 @f0
    i32 @f1
    i32 @f1
}

struct @B {
    i64 @f0
    i32 @f1
    f32 @f2
}

struct @S {
    @A @a
    @B @b
}

func f32 @test() {
    %0 = alloca @S
    %1 = memberptr @A, addr %0, void 2
    store i64 100, addr %0
    %2 = memberptr @B, addr %0, void 2
    %3 = load f32, addr %0
    ret f32 %3
}
