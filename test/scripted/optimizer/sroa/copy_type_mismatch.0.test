# test:pass "sroa"
# test:section input

struct @S {
    i32 @a
    i64 @b
}

func void @wrap() {
    %0 = alloca @S
    %1 = alloca i64
    copy addr %1, addr %0, i64
    ret
}

# test:section output

struct @S {
    i32 @a
    i64 @b
}

func void @wrap() {
    %0 = alloca @S
    %1 = alloca i64
    copy addr %1, addr %0, i64
    ret
}
