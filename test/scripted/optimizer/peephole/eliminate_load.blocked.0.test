# test:section input

func i32 @f(addr %0) {
    %1 = alloca i32
    store i32 42, addr %1
    store i32 0, addr %0
    %2 = load i32, addr %1
    ret i32 %2
}

# test:section output

func i32 @f(addr %0) {
    %1 = alloca i32
    store i32 42, addr %1
    store i32 0, addr %0
    %2 = load i32, addr %1
    ret i32 %2
}
