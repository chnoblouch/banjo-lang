# TODO: Add tests for empty tuple literals once they're supported.
# TODO: Add tests for nested arrays/tuples.

# test:subtest
# test:output "42"

var a: i32;

func main() {
    a = 42;
    print(a);
}

# test:subtest
# test:output "53,-290"

struct Point {
    var x: i32;
    var y: i32;
}

var a: Point;

func main() {
    a = Point {
        x: 53,
        y: -290,
    };
    
    print(a.x);
    print(',');
    print(a.y);
}

# test:subtest
# test:output "42,256,65536,4294967296,-42,-256,-65536,-4294967296,0.5821,-192.47,false,true,x"

var a: u8 = 42;
var b: u16 = 256;
var c: u32 = 65536;
var d: u64 = 4294967296;
var e: i8 = -42;
var f: i16 = -256;
var g: i32 = -65536;
var h: i64 = -4294967296;
var i: f32 = 0.5821;
var j: f64 = -192.47;
var k: bool = false;
var l: bool = true;
var m: char = 'x';

func main() {
    print(a as u32);
    print(',');
    print(b);
    print(',');
    print(c);
    print(',');
    print(d);
    print(',');
    print(e);
    print(',');
    print(f);
    print(',');
    print(g);
    print(',');
    print(h);
    print(',');
    print(i);
    print(',');
    print(j);
    print(',');
    print(k);
    print(',');
    print(l);
    print(',');
    print(m);
}

# test:subtest
# test:output "1,48,127,true,false,false,true,1003847,-23791283"

var a: [i32; 3] = [1, 48, 127];
var b: [bool; 4] = [true, false, false, true];
var c: [i64; 2] = [1003847, -23791283];

func main() {
    print(a[0]);
    print(',');
    print(a[1]);
    print(',');
    print(a[2]);
    print(',');
    print(b[0]);
    print(',');
    print(b[1]);
    print(',');
    print(b[2]);
    print(',');
    print(b[3]);
    print(',');
    print(c[0]);
    print(',');
    print(c[1]);
}

# test:subtest
# test:output "42,true,0.25,324187,c"

var a: (i32, bool) = (42, true);
var b: (f32, u64, char) = (0.25, 324187, 'c');

func main() {
    print(a.0);
    print(',');
    print(a.1);
    print(',');
    print(b.0);
    print(',');
    print(b.1);
    print(',');
    print(b.2);
}

# test:subtest
# test:output "null"

var a: *i32 = null;

func main() {
    print(a);

    var v = 42;
    a = &v;
}

# test:subtest
# test:output "4,-13;-27,5,47,83416203013894"

struct Point {
    var x: i8;
    var y: i8;
}

struct Circle {
    var center: Point;
    var radius: u32;
    var id: u64;
}

var a: Point = Point { x: 4, y: -13 };
var b: Circle = Circle { center: { x: -27, y: 5 }, radius: 47, id: 83416203013894 };

func main() {
    print(a.x);
    print(',');
    print(a.y);
    print(';');
    print(b.center.x);
    print(',');
    print(b.center.y);
    print(',');
    print(b.radius);
    print(',');
    print(b.id);
}

# test:subtest
# test:output "8,true"

struct S {
    var a: i32;
    var b: bool;
}

var a: S = { a: 8, b: true };

func main() {
    print(a.a);
    print(',');
    print(a.b);
}

# test:subtest
# test:output "42"

struct Empty {}

var a: Empty = Empty {};
var b: i32 = 42;

func main() {
    print(b);
}
