    var c1: char = '\xE0\xA6\x85';
    var c2: char = '\xe0\xa6\x85';
    var d1: char = '\xf0\x9f\xa6\x81';
    var d2: char = '\xF0\x9F\xA6\x81';

    print(a as u32);
    print(',');
    print(b1 as u32);
    print(',');
    print(b2 as u32);
    print(',');
    print(c1 as u32);
    print(',');
    print(c2 as u32);
    print(',');
    print(d1 as u32);
    print(',');
    print(d2 as u32);
}
