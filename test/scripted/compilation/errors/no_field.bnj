# test:subtest
# test:error 83:13 "type 'Point' has no field named 'a'"

struct Point {
    var x: i32;
    var y: i32;
}

func main() {
    var point = Point {
        x: 2,
        y: 3,
    };
    
    var pointer = &point;
    pointer.a = 2;
}

