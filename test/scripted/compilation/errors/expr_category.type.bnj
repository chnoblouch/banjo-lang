# test:subtest
# test:error 59:11 "expected type, got proto"
# test:error 59:15 "expected type, got const"

proto P {}

const C: i32 = 0;

func f[T: P | C]() {}

# test:subtest
# test:error 69:7 "expected type, got proto"

proto P {}

func f[T]() {}

func main() {
    f[P]();
}
