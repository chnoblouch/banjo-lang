# test:subtest
# test:error 8:7 "type 'S' has no method named 'test'"

struct S {}

func main() {
    var s = S {};
    s.test();
}

# test:subtest
# test:error 19:7 "type 'S' has no method named 'test'"

struct S {}

func main() {
    var s = S {};
    var p = &s;
    p.test();
}

# test:subtest
# test:error 31:7 "type 'U' has no method named 'test'"

union U {
    case C ();
}

func main() {
    var u: U = U.C();
    u.test();
}

# test:subtest
# test:error 44:7 "type '*P' has no method named 'test'"

proto P {}

struct S: P {}

func main() {
    var s = S {};
    var p: *P = &s;
    p.test();
}

# test:subtest
# test:error 51:7 "type 'T' has no method named 'test'"

func f[T](a: T) {
    a.test();
}

# test:subtest
# test:error 61:7 "type 'S[i32, bool]' has no method named 'test'"

struct S[A, B] {}

func main() {
    var s = S[i32, bool] {};
    s.test();
}
