# test:output "4010000000000000,405fc00000000000,4060000000000000,4060200000000000,406fe00000000000,"

func main() {
    var a: u8 = 4;
    var b: u8 = 0x7F;
    var c: u8 = 0x80;
    var d: u8 = 0x81;
    var e: u8 = 0xFF;

    print_f64(a as f64);
    print_f64(b as f64);
    print_f64(c as f64);
    print_f64(d as f64);
    print_f64(e as f64);
}

