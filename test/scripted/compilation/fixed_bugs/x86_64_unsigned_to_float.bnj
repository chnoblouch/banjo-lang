# test:output "4010000000000000,41dddddddfc00000,41e0000000000000,41e0000000200000,41efffffffe00000,"

func main() {
    var a: u32 = 4;
    var b: u32 = 0x7777777F;
    var c: u32 = 0x80000000;
    var d: u32 = 0x80000001;
