# test:subtest
# test:output "43800000,5f000000,4070000000000000,43e0000000000000,"

func main() {
    var a: u64 = 256;
    var b: u64 = 0x7FFFFFFFFFFFFFFF;

    print_f32(a as f32);
    print_f32(b as f32);
    print_f64(a as f64);
    print_f64(b as f64);
}

# test:subtest
# test:output "43800000,5f000000,4070000000000000,43e0000000000000,"

func main() {
    var a: u64 = 256;
    var b: u64 = 0x7FFFFFFFFFFFFFFF;

    print_f32(a as f32);
    print_f32(b as f32);
    print_f64(a as f64);
    print_f64(b as f64);
}

# test:subtest
# test:output "5f000000,5f800000,"

func main() {
    var a: u64 = 0x8000000000000000;
    var b: u64 = 0xFFFFFFFFFFFFFFFF;

    print_f32(a as f32);
    print_f32(b as f32);
}

# test:subtest
# test:output "43e0000000000000,43f0000000000000,"

func main() {
    var a: u64 = 0x8000000000000000;
    var b: u64 = 0xFFFFFFFFFFFFFFFF;

    print_f64(a as f64);
    print_f64(b as f64);
}

# test:subtest
# test:output "5f000000,5f000000,5f000001,"

func main() {
    var a: u64 = 0x8000007FFFFFFFFF;
    var b: u64 = 0x8000008000000000;
    var c: u64 = 0x8000008000000001;

    print_f32(a as f32);
    print_f32(b as f32);
    print_f32(c as f32);
}

# test:subtest
# test:output "43e0000000000000,43e0000000000000,43e0000000000001,"

func main() {
    var a: u64 = 0x80000000000003FF;
    var b: u64 = 0x8000000000000400;
    var c: u64 = 0x8000000000000401;

    print_f64(a as f64);
    print_f64(b as f64);
    print_f64(c as f64);
}