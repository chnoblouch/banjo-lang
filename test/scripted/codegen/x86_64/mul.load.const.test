# test:subtest
# test:section ssa

func i64 @f(addr %0) {
    %1 = load i64, addr %0
    %2 = mul i64 %1, i64 42
    ret i64 %2
}

# test:section mcode

func f:
    imul rax, [rdi], 42
    ret

