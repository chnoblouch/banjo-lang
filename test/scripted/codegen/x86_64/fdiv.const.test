# test:subtest
# test:section ssa

func f64 @f(f64 %0) {
    %1 = fdiv f64 %0, f64 2.5
    ret f64 %1
}

# test:section mcode

data float.0: f64(2.5)

func f:
    divsd xmm0, [float.0]
    ret

# test:subtest
# test:section ssa

func f64 @f(f64 %0) {
    %1 = fdiv f64 2.5, f64 %0
    ret f64 %1
}

# test:section mcode

data float.0: f64(2.5)

func f:
    movsd xmm1, [float.0]
    divsd xmm1, xmm0
    movapd xmm0, xmm1
    ret

# test:subtest
# test:section ssa

func f32 @f(f32 %0) {
    %1 = fdiv f32 %0, f32 2.5
    ret f32 %1
}

# test:section mcode

data float.0: f32(2.5)

func f:
    divss xmm0, [float.0]
    ret

# test:subtest
# test:section ssa

func f32 @f(f32 %0) {
    %1 = fdiv f32 2.5, f32 %0
    ret f32 %1
}

# test:section mcode

data float.0: f32(2.5)

func f:
    movss xmm1, [float.0]
    divss xmm1, xmm0
    movaps xmm0, xmm1
    ret
