# test:subtest
# test:section ssa

func f64 @f(addr %0) {
    %1 = load i64, addr %0
    %2 = utof i64 %1, f64
    ret f64 %2
}

# test:section mcode

func f:
    mov rax, [rdi]
    test rax, rax
    js b0
    xorpd xmm0, xmm0
    cvtsi2sd xmm0, rax
    jmp b1
b0:
    mov ecx, eax
    and ecx, 1
    shr rax, 1
    or rax, rcx
    xorpd xmm0, xmm0
    cvtsi2sd xmm0, rax
    addsd xmm0, xmm0
b1:
    ret

# test:subtest
# test:section ssa

func f64 @f(addr %0) {
    %1 = load i32, addr %0
    %2 = utof i32 %1, f64
    ret f64 %2
}

# test:section mcode

func f:
    mov eax, [rdi]
    xorpd xmm0, xmm0
    cvtsi2sd xmm0, rax
    ret

# test:subtest
# test:section ssa

func f64 @f(addr %0) {
    %1 = load i16, addr %0
    %2 = utof i16 %1, f64
    ret f64 %2
}

# test:section mcode

func f:
    movzx eax, word [rdi]
    xorpd xmm0, xmm0
    cvtsi2sd xmm0, eax
    ret

# test:subtest
# test:section ssa

func f64 @f(addr %0) {
