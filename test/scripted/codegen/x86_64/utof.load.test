    js b0
    xorps xmm0, xmm0
    cvtsi2ss xmm0, rax
    jmp b1
b0:
    mov ecx, eax
    and ecx, 1
    shr rax, 1
    or rax, rcx
    xorps xmm0, xmm0
    cvtsi2ss xmm0, rax
    addss xmm0, xmm0
b1:
    ret

