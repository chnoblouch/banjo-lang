# test:subtest
# test:section ssa

func i64 @f(addr %0) {
    %1 = load i32, addr %0
    %2 = uextend i32 %1, i64
    ret i64 %2
}

# test:section mcode

func f:
    mov eax, [rdi]
    ret

# test:subtest
# test:section ssa

func i64 @f(addr %0) {
    %1 = load i16, addr %0
    %2 = uextend i16 %1, i64
    ret i64 %2
}

# test:section mcode

func f:
    movzx eax, word [rdi]
    ret

# test:subtest
# test:section ssa

func i64 @f(addr %0) {
    %1 = load i8, addr %0
    %2 = uextend i8 %1, i64
    ret i64 %2
}

# test:section mcode

func f:
    movzx eax, byte [rdi]
    ret

