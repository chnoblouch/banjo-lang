# test:subtest
# test:section ssa

func i64 @f(i64 %0) {
    %1 = srem i64 %0, i64 42
    ret i64 %1
}

# test:section mcode

func f:
    mov rcx, 42
    mov rax, rdi
    cqo
    idiv rcx
    mov rax, rdx
    ret

