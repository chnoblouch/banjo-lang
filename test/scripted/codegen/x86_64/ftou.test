    ret i64 %1
}

# test:section mcode

data float.0: f64(9223372036854775808)

func f:
    ucomisd xmm0, [float.0]
    jae b0
    cvtsd2si rax, xmm0
    jmp b1
b0:
    subsd xmm0, [float.0]
    cvtsd2si rax, xmm0
    mov rcx, 9223372036854775808
    or rax, rcx
b1:
    ret

