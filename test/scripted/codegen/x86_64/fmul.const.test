# test:subtest
# test:section ssa

func f64 @f(f64 %0) {
    %1 = fmul f64 %0, f64 2.5
    ret f64 %1
}

# test:section mcode

data float.0: f64(2.5)

func f:
    mulsd xmm0, [float.0]
    ret

