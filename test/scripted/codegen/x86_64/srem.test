# test:subtest
# test:section ssa

func i64 @f(i64 %0, i64 %1) {
    %2 = srem i64 %0, i64 %1
    ret i64 %2
}

# test:section mcode

func f:
    mov rax, rdi
    cqo
    idiv rsi
    mov rax, rdx
    ret

# test:subtest
# test:section ssa

func i32 @f(i32 %0, i32 %1) {
    %2 = srem i32 %0, i32 %1
    ret i32 %2
}

# test:section mcode

func f:
    mov eax, edi
    cdq
    idiv esi
    mov eax, edx
    ret

