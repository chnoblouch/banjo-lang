# test:subtest
# test:section ssa

func void @f(addr %0) {
    %1 = load i64, addr %0
    %2 = mul i64 %1, i64 42
    store i64 %2, addr %0
    ret
}

# test:section mcode

func f:
    imul rax, [rdi], 42
    mov [rdi], rax
    ret

