# test:subtest
# test:section ssa

func i64 @f(i64 %0, i64 %1) {
    %2 = urem i64 %0, i64 %1
    ret i64 %2
}

# test:section mcode

func f:
    mov rax, rdi
    xor edx, edx
    div rsi
    mov rax, rdx
    ret

