# test:section ssa

func i32 @f(i32 %0, i32 %1) {
    %2 = urem i32 %0, i32 %1
    ret i32 %2
}

# test:section mcode

func f:
    mov eax, edi
    xor edx, edx
    div esi
    mov eax, edx
    ret

