# test:subtest
# test:section ssa

func i64 @f(addr %0) {
    %1 = load f64, addr %0
    %2 = ftou f64 %1, i64
    ret i64 %2
}

# test:section mcode

data float.0: f64(9223372036854775808)

func f:
    movsd xmm0, [rdi]
    ucomisd xmm0, [float.0]
    jae b0
    cvtsd2si rax, xmm0
    jmp b1
b0:
    subsd xmm0, [float.0]
    cvtsd2si rax, xmm0
    mov rcx, 9223372036854775808
    or rax, rcx
b1:
    ret

