# test:subtest
# test:section ssa

func i64 @f(addr %0, i64 %1) {
    %2 = atomic_and addr %0, i64 %1
    ret i64 %2
}

# test:section mcode

func f:
    mov rax, [rdi]
b0:
    mov rcx, rax
    and rcx, rsi
    lock cmpxchg [rdi], rcx
    jne b0
    ret

