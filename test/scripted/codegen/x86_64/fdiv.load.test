# test:subtest
# test:section ssa

func f64 @f(addr %0, f64 %1) {
    %2 = load f64, addr %0
    %3 = fdiv f64 %2, f64 %1
    ret f64 %3
}

# test:section mcode

func f:
    movsd xmm1, [rdi]
    divsd xmm1, xmm0
    movapd xmm0, xmm1
    ret

# test:subtest
# test:section ssa

func f64 @f(f64 %0, addr %1) {
    %2 = load f64, addr %1
    %3 = fdiv f64 %0, f64 %2
    ret f64 %3
}

# test:section mcode

func f:
    divsd xmm0, [rdi]
    ret

# test:subtest
# test:section ssa

func f32 @f(addr %0, f32 %1) {
    %2 = load f32, addr %0
    %3 = fdiv f32 %2, f32 %1
    ret f32 %3
}

# test:section mcode

func f:
    movss xmm1, [rdi]
    divss xmm1, xmm0
    movaps xmm0, xmm1
    ret

# test:subtest
# test:section ssa

func f32 @f(f32 %0, addr %1) {
    %2 = load f32, addr %1
    %3 = fdiv f32 %0, f32 %2
    ret f32 %3
}

# test:section mcode

func f:
    divss xmm0, [rdi]
    ret
