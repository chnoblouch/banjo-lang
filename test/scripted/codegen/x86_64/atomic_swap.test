# test:subtest
# test:section ssa

func i64 @f(addr %0, i64 %1) {
    %2 = atomic_swap addr %0, i64 %1
    ret i64 %2
}

# test:section mcode

func f:
    xchg [rdi], rsi
    mov rax, rsi
    ret

