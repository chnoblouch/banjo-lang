# test:subtest
# test:section ssa

func void @f(addr %0, i64 %1) {
    %2 = load i64, addr %0
    %3 = ashr i64 %2, i64 %1
    store i64 %3, addr %0
    ret
}

# test:section mcode

func f:
    mov ecx, esi
    sar qword [rdi], cl
    ret

