# test:subtest
# test:section ssa

func void @f(addr %0) {
    %1 = load i64, addr %0
    %2 = lshl i64 %1, i64 3
    store i64 %2, addr %0
    ret
}

# test:section mcode

func f:
    shl qword [rdi], 3
    ret

