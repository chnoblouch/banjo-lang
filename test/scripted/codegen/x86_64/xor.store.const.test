# test:subtest
# test:section ssa

func void @f(i64 %0, addr %1) {
    %2 = xor i64 %0, i64 42
    store i64 %2, addr %1
    ret
}

# test:section mcode

func f:
    xor rdi, 42
    mov [rsi], rdi
    ret

