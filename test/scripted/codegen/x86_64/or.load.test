# test:subtest
# test:section ssa

func i64 @f(addr %0, i64 %1) {
    %2 = load i64, addr %0
    %3 = or i64 %2, i64 %1
    ret i64 %3
}

# test:section mcode

func f:
    or rsi, [rdi]
    mov rax, rsi
    ret

# test:subtest
# test:section ssa

func i64 @f(i64 %0, addr %1) {
    %2 = load i64, addr %1
    %3 = or i64 %0, i64 %2
    ret i64 %3
}

# test:section mcode

func f:
    or rdi, [rsi]
    mov rax, rdi
    ret

