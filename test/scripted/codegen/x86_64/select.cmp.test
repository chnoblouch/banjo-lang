# test:subtest
# test:section ssa

func i8 @f(i64 %0, i64 %1, i8 %2, i8 %3) {
    %4 = select i64 %0, void eq, i64 %1, i8 %2, i8 %3
    ret i8 %4
}

# test:section mcode

func f:
    cmp rdi, rsi
    cmove ecx, edx
    mov eax, ecx
    ret

