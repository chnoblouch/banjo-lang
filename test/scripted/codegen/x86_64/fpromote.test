# test:subtest
# test:section ssa

func f64 @f(f32 %0) {
    %1 = fpromote f32 %0, f64
    ret f64 %1
}

# test:section mcode

func f:
    cvtss2sd xmm0, xmm0
    ret

# test:subtest
# test:section ssa

func f64 @f(addr %0) {
    %1 = load f32, addr %0
    %2 = fpromote f32 %1, f64
    ret f64 %2
}

# test:section mcode

func f:
    cvtss2sd xmm0, [rdi]
    ret

# test:subtest
# test:section ssa

func f64 @f() {
    %0 = fpromote f32 2.5, f64
    ret f64 %0
}

# test:section mcode

data float.0: f32(2.5)

func f:
    cvtss2sd xmm0, [float.0]
    ret
