# test:section ssa

func i32 @f(addr %0, i32 %1, i32 %2, addr %3) {
    %4 = atomic_cmpswap addr %0, i32 %1, i32 %2, addr %3
    ret i32 %4
}

# test:section mcode

func f:
    mov eax, esi
    lock cmpxchg [rdi], edx
    sete [rcx]
    ret

