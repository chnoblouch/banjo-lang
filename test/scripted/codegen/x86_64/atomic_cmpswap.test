# test:subtest
# test:section ssa

func i64 @f(addr %0, i64 %1, i64 %2, addr %3) {
    %4 = atomic_cmpswap addr %0, i64 %1, i64 %2, addr %3
    ret i64 %4
}

# test:section mcode

func f:
    mov rax, rsi
    lock cmpxchg [rdi], rdx
    sete [rcx]
    ret

