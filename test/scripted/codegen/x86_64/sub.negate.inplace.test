# test:subtest
# test:section ssa

func void @f(addr %0) {
    %1 = load i64, addr %0
    %2 = sub i64 0, i64 %1
    store i64 %2, addr %0
    ret
}

# test:section mcode

func f:
    neg qword [rdi]
    ret

