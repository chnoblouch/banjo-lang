# test:subtest
# test:section ssa

# TODO: This should be `mov eax, edi`, but the register allocator is currently
# unable to fold this.

func i64 @f(i32 %0) {
    %1 = uextend i32 %0, i64
    ret i64 %1
}

# test:section mcode

func f:
    mov edi, edi
    mov rax, rdi
    ret

# test:subtest
# test:section ssa

func i64 @f(i16 %0) {
    %1 = uextend i16 %0, i64
    ret i64 %1
}

# test:section mcode

func f:
    movzx eax, di
    ret

# test:subtest
# test:section ssa

func i64 @f(i8 %0) {
    %1 = uextend i8 %0, i64
    ret i64 %1
}

# test:section mcode

func f:
    movzx eax, dil
    ret

