# test:subtest
# test:section ssa

func i64 @f(addr %0) {
    %1 = load f64, addr %0
    %2 = ftos f64 %1, i64
    ret i64 %2
}

# test:section mcode

func f:
    cvtsd2si rax, [rdi]
    ret

# test:subtest
# test:section ssa

func i32 @f(addr %0) {
    %1 = load f64, addr %0
    %2 = ftos f64 %1, i32
    ret i32 %2
}

# test:section mcode

func f:
    cvtsd2si eax, [rdi]
    ret

