# test:subtest
# test:section ssa

func i64 @f(addr %0, addr %1) {
    %2 = load i64, addr %0
    %3 = load i64, addr %1
    %4 = udiv i64 %2, i64 %3
    ret i64 %4
}

# test:section mcode

func f:
    mov rax, [rdi]
    xor edx, edx
    div qword [rsi]
    ret

