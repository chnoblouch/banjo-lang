# test:section ssa

func i32 @f(addr %0, addr %1) {
    %2 = load i32, addr %0
    %3 = load i32, addr %1
    %4 = udiv i32 %2, i32 %3
    ret i32 %4
}

# test:section mcode

func f:
    mov eax, [rdi]
    xor edx, edx
    div dword [rsi]
    ret

