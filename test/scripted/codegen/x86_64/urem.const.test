# test:subtest
# test:section ssa

func i64 @f(i64 %0) {
    %1 = urem i64 %0, i64 42
    ret i64 %1
}

# test:section mcode

func f:
    mov rcx, 42
    mov rax, rdi
    xor edx, edx
    div rcx
    mov rax, rdx
    ret

# test:subtest
# test:section ssa

func i64 @f(i64 %0) {
    %1 = urem i64 42, i64 %0
    ret i64 %1
}

# test:section mcode

func f:
    mov rax, 42
    xor edx, edx
    div rdi
    mov rax, rdx
    ret

