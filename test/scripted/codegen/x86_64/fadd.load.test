# test:subtest
# test:section ssa

func f64 @f(addr %0, f64 %1) {
    %2 = load f64, addr %0
    %3 = fadd f64 %2, f64 %1
    ret f64 %3
}

# test:section mcode

func f:
    addsd xmm0, [rdi]
    ret

# test:subtest
# test:section ssa

func f64 @f(f64 %0, addr %1) {
    %2 = load f64, addr %1
    %3 = fadd f64 %0, f64 %2
    ret f64 %3
}

# test:section mcode

func f:
    addsd xmm0, [rdi]
    ret

