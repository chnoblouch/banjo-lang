# test:subtest
# test:section ssa

func void @f(i64 %0, i64 %1) {
    %2 = ashr i64 %0, i64 %1
    ret i64 %2
}

# test:section mcode

func f:
    mov ecx, esi
    sar rdi, cl
    mov rax, rdi
    ret

