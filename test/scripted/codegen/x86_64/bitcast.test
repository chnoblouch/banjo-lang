# test:subtest
# test:section ssa

func f32 @f(i32 %0) {
    %1 = bitcast i32 %0, f32
    ret f32 %1
}

# test:section mcode

func f:
    movd xmm0, edi
    ret

# test:subtest
# test:section ssa

func f64 @f(i64 %0) {
    %1 = bitcast i64 %0, f64
    ret f64 %1
}

# test:section mcode

func f:
    movq xmm0, rdi
    ret

# test:subtest
# test:section ssa

func i32 @f(f32 %0) {
    %1 = bitcast f32 %0, i32
    ret i32 %1
}

# test:section mcode

func f:
    movd eax, xmm0
    ret

# test:subtest
# test:section ssa

func i64 @f(f64 %0) {
    %1 = bitcast f64 %0, i64
    ret i64 %1
}

# test:section mcode

func f:
    movq rax, xmm0
    ret
