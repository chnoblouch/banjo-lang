# test:subtest
# test:section ssa

func void @f(addr, i8) {
    %0 = loadarg addr, void 0
    %1 = loadarg i8, void 1
    %2 = load i8, addr %0
    %3 = add i8 %1, i8 %2
    store i8 %3, addr %0
    ret
}

# test:section mcode

func f:
    add [rdi], sil
    ret

