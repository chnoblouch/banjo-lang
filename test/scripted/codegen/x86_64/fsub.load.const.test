# test:subtest
# test:section ssa

func f64 @f(addr %0) {
    %1 = load f64, addr %0
    %2 = fsub f64 %1, f64 2.5
    ret f64 %2
}

# test:section mcode

data float.0: f64(2.5)

func f:
    movsd xmm0, [rdi]
    subsd xmm0, [float.0]
    ret

# test:subtest
# test:section ssa

func f64 @f(addr %0) {
    %1 = load f64, addr %0
    %2 = fsub f64 2.5, f64 %1
    ret f64 %2
}

# test:section mcode

data float.0: f64(2.5)

func f:
    movsd xmm0, [float.0]
    subsd xmm0, [rdi]
    ret

