# test:subtest
# test:section ssa

func void @f(addr %0, i8 %1) {
    %2 = load i8, addr %0
    %3 = add i8 %2, i8 %1
    store i8 %3, addr %0 
    ret
}

# test:section mcode

func f:
    add [rdi], sil
    ret

