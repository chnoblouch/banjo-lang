# test:subtest
# test:section ssa

func f32 @f(addr %0) {
    %1 = load i32, addr %0
    %2 = bitcast i32 %1, f32
    ret f32 %2
}

# test:section mcode

func f:
    movss xmm0, [rdi]
    ret

# test:subtest
# test:section ssa

func f64 @f(addr %0) {
    %1 = load i64, addr %0
    %2 = bitcast i64 %1, f64
    ret f64 %2
}

# test:section mcode

func f:
    movsd xmm0, [rdi]
    ret

# test:subtest
# test:section ssa

func i32 @f(addr %0) {
    %1 = load f32, addr %0
    %2 = bitcast f32 %1, i32
    ret i32 %2
}

# test:section mcode

func f:
    mov eax, [rdi]
    ret

# test:subtest
# test:section ssa

func i64 @f(addr %0) {
    %1 = load f64, addr %0
    %2 = bitcast f64 %1, i64
    ret i64 %2
