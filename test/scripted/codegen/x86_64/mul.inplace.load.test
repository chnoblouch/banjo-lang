# test:subtest
# test:section ssa

func void @f(addr %0, addr %1) {
    %2 = load i64, addr %0
    %3 = load i64, addr %1
    %4 = mul i64 %2, i64 %3
    store i64 %4, addr %0
    ret
}

# test:section mcode

func f:
    mov rax, [rdi]
    imul qword [rsi]
    mov [rdi], rax
    ret

