# test:subtest
# test:section ssa

func f32 @f(f64 %0) {
    %1 = fdemote f64 %0, f32
    ret f32 %1
}

# test:section mcode

func f:
    cvtsd2ss xmm0, xmm0
    ret

# test:subtest
# test:section ssa

func f32 @f(addr %0) {
    %1 = load f64, addr %0
    %2 = fdemote f64 %1, f32
    ret f32 %2
}

# test:section mcode

func f:
    cvtsd2ss xmm0, [rdi]
    ret

# test:subtest
# test:section ssa

func f64 @f() {
    %0 = fdemote f64 2.5, f32
    ret f64 %0
}

# test:section mcode

data float.0: f64(2.5)

func f:
    cvtsd2ss xmm0, [float.0]
    ret
