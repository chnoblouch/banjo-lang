# test:subtest
# test:section ssa

func void @f(i64 %0, i64 %1) {
    %2 = xor i64 %0, i64 %1
    ret i64 %2
}

# test:section mcode

func f:
    xor rdi, rsi
    mov rax, rdi
    ret

