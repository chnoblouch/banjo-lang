# test:subtest
# test:section ssa

func void @f(addr %0) {
    %1 = load i64, addr %0
    %2 = xor i64 %1, i64 18446744073709551615
    store i64 %2, addr %0
    ret
}

# test:section mcode

func f:
    not qword [rdi]
    ret

