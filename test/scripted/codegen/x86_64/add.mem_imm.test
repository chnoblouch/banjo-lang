# test:subtest
# test:section ssa

func void @f(addr):
    %0 = loadarg addr, void 0
    %1 = load i8, addr %0
    %2 = add i8 %1, i8 42
    store i8 %2, addr %0
    ret

# test:section mcode

func f:
    add byte [rdi], 42
    ret

