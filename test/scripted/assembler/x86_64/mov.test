mov dword [r11], 42

# test:subtest
# test:encoding "66C7012A00"

mov word [rcx], 42

# test:subtest
# test:encoding "6641C7032A00"

mov word [r11], 42

# test:subtest
# test:encoding "C6012A"

mov byte [rcx], 42

# test:subtest
# test:encoding "41C6032A"

mov byte [r11], 42
