# Thanks to:
#   - https://en.wikipedia.org/wiki/Sieve_of_Eratosthenes
#   - https://github.com/smarr/are-we-fast-yet/blob/master/benchmarks/JavaScript/sieve.js

const LIMIT: usize = 50000000;

func main() {
    var flags = Array[bool].new();

    for _ in 0..LIMIT + 1 {
        flags.append(true);
    }

    var num_primes = 0;

    for i in 2..LIMIT + 1 {
        if !flags[i] {
            continue;
        }

        var p = 2 * i;

        while p <= LIMIT {
            flags[p] = false;
            p += i;
        }

        num_primes += 1;
    }

    println(num_primes);
}
