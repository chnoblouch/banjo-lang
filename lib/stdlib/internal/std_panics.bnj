use std.convert.to_string as str;

@never_inline
func panic_assertion_failed(message: String) {
    panic("assertion failed: " + message);
}

@never_inline
func panic_unwrap_optional() {
    panic("optional does not have a value");
}

@never_inline
func panic_unwrap_result[E](ref error: E) {
    panic("tried to unwrap error result: " + str(error));
}

@never_inline
func panic_unwrap_error_result() {
    panic("tried to unwrap successful result to error");
}

@never_inline
func panic_out_of_bounds_insert_array(index: usize, length: usize) {
    panic("insertion index out of bounds (index: " + str(index) + ", array length: " + str(length) + ")");
}

@never_inline
func panic_out_of_bounds_remove_array(index: usize, length: usize) {
    panic("index to remove out of bounds (index: " + str(index) + ", array length: " + str(length) + ")");
}

@never_inline
func panic_slice_out_of_bounds(index: usize, length: usize) {
    panic("index out of bounds (index: " + str(index) + ", array length: " + str(length) + ")");
}

@never_inline
func panic_slice_start_greater_than_end(start: usize, end: usize) {
    panic("subslice start greater than end (start index: " + str(start) + ", end index: " + str(end) + ")");
}

@never_inline
func panic_slice_start_out_of_bounds(index: usize, length: usize) {
    panic("subslice start out of bounds (start index: " + str(index) + ", array length: " + str(length) + ")");
}

@never_inline
func panic_slice_end_out_of_bounds(index: usize, length: usize) {
    panic("subslice end out of bounds (end index: " + str(index) + ", array length: " + str(length) + ")");
}

@never_inline
func panic_slice_cannot_compare[T]() {
    panic("cannot compare slices (type '" + str(meta(T).name) + "' does not implement 'Compare')");
}

@never_inline
func panic_string_out_of_bounds(index: usize, length: usize) {
    panic("index out of bounds (index: " + str(index) + ", string length: " + str(length) + ")");
}

@never_inline
func panic_string_start_greater_than_end(start: usize, end: usize) {
    panic("substring start greater than end (start index: " + str(start) + ", end index: " + str(end) + ")");
}

@never_inline
func panic_string_start_out_of_bounds(index: usize, length: usize) {
    panic("substring start out of bounds (start index: " + str(index) + ", string length: " + str(length) + ")");
}

@never_inline
func panic_string_end_out_of_bounds(index: usize, length: usize) {
    panic("substring end out of bounds (end index: " + str(index) + ", string length: " + str(length) + ")");
}

@never_inline
func panic_invalid_utf8() {
    panic("invalid utf-8 sequence");
}

@never_inline
func panic_utf8_not_at_boundary(index: usize) {
    panic("index is not at a utf-8 character boundary (index: " + str(index) + ")");
}

@never_inline
func panic_out_of_memory(alloc_size: usize) {
    panic("out of heap memory (failed to allocate " + str(alloc_size) + " bytes)");
}

@never_inline
func panic_cannot_find_key_map[K](ref key: K) {
    panic("cannot find key '" + str(key) + "' in map");
}

@never_inline
func panic_cannot_copy_array[T]() {
    panic("cannot copy array (type '" + str(meta(T).name) + "' does not implement 'Copy')");
}

@never_inline
func panic_cannot_copy_map[T]() {
    panic("cannot copy map (type '" + str(meta(T).name) + "' does not implement 'Copy')");
}

@never_inline
func panic_invalid_format_template() {
    panic("invalid format template");
}
