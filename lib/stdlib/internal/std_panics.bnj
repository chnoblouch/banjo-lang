use std.convert.to_string as str;

@never_inline
func panic_assertion_failed(message: String) {
    panic("assertion failed: " + message);
}

@never_inline
func panic_unwrap_optional() {
    panic("optional does not have a value");
}

@never_inline
func panic_unwrap_result[E](ref error: E) {
    panic("tried to unwrap error result: " + str(error));
}

@never_inline
func panic_unwrap_error_result() {
    panic("tried to unwrap successful result to error");
}

@never_inline
func panic_out_of_bounds_array(index: usize, length: usize) {
    panic("index out of bounds (index: " + str(index) + ", array length: " + str(length) + ")");
}

@never_inline
func panic_out_of_bounds_string(index: usize, length: usize) {
    panic("index out of bounds (index: " + str(index) + ", string length: " + str(length) + ")");
}

@never_inline
func panic_out_of_bounds_insert_array(index: usize, length: usize) {
    panic("insertion index out of bounds (index: " + str(index) + ", array length: " + str(length) + ")");
}

@never_inline
func panic_out_of_bounds_remove_array(index: usize, length: usize) {
    panic("index to remove out of bounds (index: " + str(index) + ", array length: " + str(length) + ")");
}

@never_inline
func panic_out_of_memory(alloc_size: usize) {
    panic("out of heap memory (failed to allocate " + str(alloc_size) + " bytes)");
}

@never_inline
func panic_cannot_find_key_map[K](ref key: K) {
    panic("cannot find key '" + str(key) + "' in map");
}

@never_inline
func panic_cannot_copy_array[T]() {
    panic("cannot copy array (type '" + str(meta(T).name) + "' does not implement 'Copy')");
}

@never_inline
func panic_cannot_copy_map[T]() {
    panic("cannot copy map (type '" + str(meta(T).name) + "' does not implement 'Copy')");
}

@never_inline
func panic_cannot_compare_slices[T]() {
    panic("cannot compare slices (type '" + str(meta(T).name) + "' does not implement 'Compare')");
}

@never_inline
func panic_invalid_format_template() {
    panic("invalid format template");
}

@never_inline
func panic_cannot_convert_to_path[T]() {
    panic("cannot create path from type '" + str(meta(T).name) + "'");
}
