use std.{config, convert, format, stack_trace};
use libc as c;
use os;
use internal.std_panics.panic_assertion_failed;

meta if os.IS_WINDOWS {
    use std.unicode;
    use os.winapi;
} else if os.IS_UNIX {
    use os.posix;
}

pub func print[T](ref value: T) {
    var string = convert.to_string(value);
    write_to_stdout(string.slice());
}

pub func println[T](ref value: T) {
    var string = convert.to_string(value);
    write_to_stdout(string.slice());

    var line_ending: u8 = '\n';
    write_to_stdout(StringSlice.new(&line_ending, 1));
}

pub func fprint[Args: ...](template: StringSlice, args: Args) {
    var string = format.format_packed(template, args);
    write_to_stdout(string.slice());
}

pub func fprintln[Args: ...](template: StringSlice, args: Args) {
    var string = format.format_packed(template, args);
    write_to_stdout(string.slice());

    var line_ending: u8 = '\n';
    write_to_stdout(StringSlice.new(&line_ending, 1));
}

pub func exit(status: i32) {
    c.exit(status);
}

pub func assert(condition: bool, message: String) {
    if !condition {
        panic_assertion_failed(message);
    }
}

pub func panic(message: String) {
    println("\n================================================================");
    print("panic: ");
    println(message);

    meta if config.BUILD_CONFIG == config.DEBUG {
        stack_trace.print_stack_trace();
    }

    println("================================================================\n");

    exit(1);
}

func write_to_stdout(string: StringSlice) {
    meta if os.IS_WINDOWS {
        var handle = winapi.get_std_handle(winapi.STD_OUTPUT_HANDLE);
        if handle == winapi.INVALID_HANDLE_VALUE {
            return;
        }

        var console_mode: winapi.Dword = undefined;
        var bytes_written: winapi.Dword = undefined;

        if winapi.get_console_mode(handle, &console_mode) != 0 {
            var data_utf16 = unicode.utf8_string_to_utf16(string);

            winapi.write_console(
                handle,
                data_utf16.data(),
                data_utf16.length() as winapi.Dword,
                &bytes_written,
                null,
            );
        } else {
            winapi.write_file(
                handle,
                string.data,
                string.length as winapi.Dword,
                &bytes_written,
                null,
            );
        }
    } else if os.IS_UNIX {
        c.fwrite(string.data, string.length, 1, posix.stdout);
    }
}
