pub func utf8_string_to_utf16(string: StringSlice) -> Array[u16] {
    var result: Array[u16] = [];
    var index: usize = 0;

    while index < string.length() {
        var c = string[index];

        if (c & 0x80 == 0) {
            result.append(c as u16);
            index += 1;
        } else if (c & 0xE0 == 0xC0) {
            var c1 = c as u16;
            var c2 = string[index + 1] as u16;

            result.append(((c1 & 0x1F) << 6) | (c2 & 0x3F));
            index += 2;
        } else if (c & 0xF0 == 0xE0) {
            var c1 = c as u16;
            var c2 = string[index + 1] as u16;
            var c3 = string[index + 2] as u16;

            result.append(((c1 & 0x0F) << 12) | ((c2 & 0x3F) << 6) | (c3 & 0x3F));
            index += 3;
        } else if (c & 0xF8 == 0xF0) {
            var c1 = c as u32;
            var c2 = string[index + 1] as u32;
            var c3 = string[index + 2] as u32;
            var c4 = string[index + 3] as u32;

            var code_point = ((c1 & 0x07) << 18) | ((c2 & 0x3F) << 12) | ((c3 & 0x3F) << 6) | (c4 & 0x3F);
            var value = code_point - 0x10000;

            result.append(0xD800 + ((value >> 10) & 0x3FF) as u16);
            result.append(0xDC00 + (value & 0x3FF) as u16);

            index += 4;
        } else {
            panic("invalid utf-8 sequence");
        }
    }

    return result;
}

pub func utf16_to_utf8_string(array: Slice[u16]) -> String {
    var result: Array[u8] = [];
    var index: usize = 0;

    while index < array.length() {
        var c = array[index];

        if c < 0xD800 || c > 0xDFFF {
            if c < 0x0080 {
                result.append(c as u8);
            } else if c < 0x0800 {
                result.append((0xC0 | ((c >> 6) & 0x1F)) as u8);
                result.append((0x80 | (c & 0x3F)) as u8);
            } else {
                result.append((0xE0) | ((c >> 12) & 0x0F) as u8);
                result.append((0x80 | ((c >> 6) & 0x3F)) as u8);
                result.append((0x80 | (c & 0x3F)) as u8);
            }

            index += 1;
        } else {
            var c1 = c as u32;
            var c2 = array[index + 1] as u32;

            if c1 > 0xDBFF || c2 < 0xDC00 || c2 > 0xDFFF {
                panic("invalid utf-16 sequence");
            }

            var value = ((c1 - 0xD800) << 10) | (c2 - 0xDC00);
            var code_point = value + 0x10000;

            result.append((0xF0 | ((code_point >> 18) & 0x7F)) as u8);
            result.append((0x80 | ((code_point >> 12) & 0x3F)) as u8);
            result.append((0x80 | ((code_point >> 6) & 0x3F)) as u8);
            result.append((0x80 | (code_point & 0x3F)) as u8);

            index += 2;
        }
    }

    return String.from(StringSlice.new(result.data(), result.length()));
}
