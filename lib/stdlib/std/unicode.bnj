pub func utf8_string_to_utf16(string: StringSlice) -> Array[u16] {
    var result: Array[u16] = [];
    var index: usize = 0;

    while index < string.length() {
        var c = string[index];

        if (c & 0x80 == 0) {
            result.append(c as u16);
            index += 1;
        } else if (c & 0xE0 == 0xC0) {
            var c1 = c as u16;
            var c2 = string[index + 1] as u16;

            result.append(((c1 & 0x1F) << 6) | (c2 & 0x3F));
            index += 2;
        } else if (c & 0xF0 == 0xE0) {
            var c1 = c as u16;
            var c2 = string[index + 1] as u16;
            var c3 = string[index + 2] as u16;

            result.append(((c1 & 0x0F) << 12) | ((c2 & 0x3F) << 6) | (c3 & 0x3F));
            index += 3;
        } else if (c & 0xF8 == 0xF0) {
            var c1 = c as u32;
            var c2 = string[index + 1] as u32;
            var c3 = string[index + 2] as u32;
            var c4 = string[index + 3] as u32;

            var code_point = ((c1 & 0x07) << 18) | ((c2 & 0x3F) << 12) | ((c3 & 0x3F) << 6) | (c4 & 0x3F);
            var value = code_point - 0x10000;

            result.append(0xD800 + ((value >> 10) & 0x3FF) as u16);
            result.append(0xDC00 + (value & 0x3FF) as u16);

            index += 4;
        } else {
            panic("invalid utf-8 sequence");
        }
    }

    return result;
}
