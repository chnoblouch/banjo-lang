struct EncodeUtf8Result {
    var bytes: [u8; 4];
    var length: usize;
}

struct EncodeUtf16Result {
    var values: [u16; 2];
    var length: usize;
}

struct DecodeResult {
    var codepoint: u32;
    var num_consumed: usize;
}

pub func encode_utf8(codepoint: u32) -> EncodeUtf8Result {
    if codepoint < 0x0080 {
        return EncodeUtf8Result {
            bytes: [
                codepoint as u8,
                undefined,
                undefined,
                undefined,
            ],
            length: 1,
        };
    } else if codepoint < 0x0800 {
        return EncodeUtf8Result {
            bytes: [
                (0xC0 | ((codepoint >> 6) & 0x1F)) as u8,
                (0x80 | (codepoint & 0x3F)) as u8,
                undefined,
                undefined,
            ],
            length: 2,
        };
    } else if codepoint < 0x10000 {
        return EncodeUtf8Result {
            bytes: [
                (0xE0 | ((codepoint >> 12) & 0x0F)) as u8,
                (0x80 | ((codepoint >> 6) & 0x3F)) as u8,
                (0x80 | (codepoint & 0x3F)) as u8,
                undefined,
            ],
            length: 3,
        };
    } else {
        return EncodeUtf8Result {
            bytes: [
                (0xF0 | ((codepoint >> 18) & 0x7F)) as u8,
                (0x80 | ((codepoint >> 12) & 0x3F)) as u8,
                (0x80 | ((codepoint >> 6) & 0x3F)) as u8,
                (0x80 | (codepoint & 0x3F)) as u8,
            ],
            length: 4,
        };
    }
}

pub func decode_utf8(slice: Slice[u8]) -> DecodeResult {
    var c = slice[0];

    if (c & 0x80 == 0) {
        return DecodeResult {
            codepoint: c as u32,
            num_consumed: 1,
        };
    } else if (c & 0xE0 == 0xC0) {
        var c1 = c as u32;
        var c2 = slice[1] as u32;

        return DecodeResult {
            codepoint: ((c1 & 0x1F) << 6) | (c2 & 0x3F),
            num_consumed: 2,
        };
    } else if (c & 0xF0 == 0xE0) {
        var c1 = c as u32;
        var c2 = slice[1] as u32;
        var c3 = slice[2] as u32;

        return DecodeResult {
            codepoint: ((c1 & 0x0F) << 12) | ((c2 & 0x3F) << 6) | (c3 & 0x3F),
            num_consumed: 3,
        };
    } else {
        if (c & 0xF8 != 0xF0) {
            panic("invalid utf-8 sequence");
        }

        var c1 = c as u32;
        var c2 = slice[1] as u32;
        var c3 = slice[2] as u32;
        var c4 = slice[3] as u32;

        return DecodeResult {
            codepoint: ((c1 & 0x07) << 18) | ((c2 & 0x3F) << 12) | ((c3 & 0x3F) << 6) | (c4 & 0x3F),
            num_consumed: 4,
        };
    }
}

pub func encode_utf16(codepoint: u32) -> EncodeUtf16Result {
    if codepoint < 0x10000 {
        return EncodeUtf16Result {
            values: [
                codepoint as u16,
                undefined,
            ],
            length: 1,
        };
    } else {
        var value = codepoint - 0x10000;

        return EncodeUtf16Result {
            values: [
                0xD800 + ((value >> 10) & 0x3FF) as u16,
                0xDC00 + (value & 0x3FF) as u16,
            ],
            length: 2,
        };
    }
}

pub func decode_utf16(slice: Slice[u16]) -> DecodeResult {
    var c = slice[0];

    if c < 0xD800 || c > 0xDFFF {
        return DecodeResult {
            codepoint: c as u32,
            num_consumed: 1,
        };
    } else {
        var c1 = c as u32;
        var c2 = slice[1] as u32;

        if c1 > 0xDBFF || c2 < 0xDC00 || c2 > 0xDFFF {
            panic("invalid utf-16 sequence");
        }

        var value = ((c1 - 0xD800) << 10) | (c2 - 0xDC00);

        return DecodeResult {
            codepoint: 0x10000 + value,
            num_consumed: 2,
        };
    }
}

pub func utf8_string_to_utf16(string: StringSlice) -> Array[u16] {
    var slice = Slice[u8].new(string.data(), string.length());

    var result: Array[u16] = [];
    var index: usize = 0;

    while index < string.length() {
        var decoded = decode_utf8(slice.subslice(index, slice.length()));
        var utf16 = encode_utf16(decoded.codepoint);

        for i in 0..utf16.length {
            result.append(utf16.values[i]);
        }

        index += decoded.num_consumed;
    }

    return result;
}

pub func utf16_to_utf8_string(slice: Slice[u16]) -> String {
    var result: Array[u8] = [];
    var index: usize = 0;

    while index < slice.length() {
        var decoded = decode_utf16(slice.subslice(index, slice.length()));
        var utf8 = encode_utf8(decoded.codepoint);

        for i in 0..utf8.length {
            result.append(utf8.bytes[i]);
        }

        index += decoded.num_consumed;
    }

    return String.from(StringSlice.new(result.data(), result.length()));
}
