struct EncodeUtf8Result {
    var bytes: [u8; 4];
    var length: usize;
}

struct EncodeUtf16Result {
    var values: [u16; 2];
    var length: usize;
}

struct DecodeResult {
    var codepoint: u32;
    var num_consumed: usize;
}

pub func encode_utf8(codepoint: u32) -> EncodeUtf8Result {
    if codepoint < 0x0080 {
        return EncodeUtf8Result {
            bytes: [
                codepoint as u8,
                undefined,
                undefined,
                undefined,
            ],
            length: 1,
        };
    } else if codepoint < 0x0800 {
        return EncodeUtf8Result {
            bytes: [
                (0xC0 | ((codepoint >> 6) & 0x1F)) as u8,
                (0x80 | (codepoint & 0x3F)) as u8,
                undefined,
                undefined,
            ],
            length: 2,
        };
    } else if codepoint < 0x10000 {
        return EncodeUtf8Result {
            bytes: [
                (0xE0 | ((codepoint >> 12) & 0x0F)) as u8,
                (0x80 | ((codepoint >> 6) & 0x3F)) as u8,
                (0x80 | (codepoint & 0x3F)) as u8,
                undefined,
            ],
            length: 3,
        };
    } else {
        return EncodeUtf8Result {
            bytes: [
                (0xF0 | ((codepoint >> 18) & 0x7F)) as u8,
                (0x80 | ((codepoint >> 12) & 0x3F)) as u8,
                (0x80 | ((codepoint >> 6) & 0x3F)) as u8,
                (0x80 | (codepoint & 0x3F)) as u8,
            ],
            length: 4,
        };
    }
}

pub func decode_utf8(slice: Slice[u8]) -> DecodeResult {
    var c = slice[0];

    if c & 0x80 == 0 {
        return DecodeResult {
            codepoint: c as u32,
            num_consumed: 1,
        };
    } else if c & 0xE0 == 0xC0 {
        var c1 = c as u32;
        var c2 = slice[1] as u32;

        return DecodeResult {
            codepoint: ((c1 & 0x1F) << 6) | (c2 & 0x3F),
            num_consumed: 2,
        };
    } else if c & 0xF0 == 0xE0 {
        var c1 = c as u32;
        var c2 = slice[1] as u32;
        var c3 = slice[2] as u32;

        return DecodeResult {
            codepoint: ((c1 & 0x0F) << 12) | ((c2 & 0x3F) << 6) | (c3 & 0x3F),
            num_consumed: 3,
        };
    } else {
        if c & 0xF8 != 0xF0 {
            panic("invalid utf-8 sequence");
        }

        var c1 = c as u32;
        var c2 = slice[1] as u32;
        var c3 = slice[2] as u32;
        var c4 = slice[3] as u32;

        return DecodeResult {
            codepoint: ((c1 & 0x07) << 18) | ((c2 & 0x3F) << 12) | ((c3 & 0x3F) << 6) | (c4 & 0x3F),
            num_consumed: 4,
        };
    }
}

pub func encode_utf16(codepoint: u32) -> EncodeUtf16Result {
    if codepoint < 0x10000 {
        return EncodeUtf16Result {
            values: [
                codepoint as u16,
                undefined,
            ],
            length: 1,
        };
    } else {
        var value = codepoint - 0x10000;

        return EncodeUtf16Result {
            values: [
                0xD800 + ((value >> 10) & 0x3FF) as u16,
                0xDC00 + (value & 0x3FF) as u16,
            ],
            length: 2,
        };
    }
}

pub func decode_utf16(slice: Slice[u16]) -> DecodeResult {
    var c = slice[0];

    if c < 0xD800 || c > 0xDFFF {
        return DecodeResult {
            codepoint: c as u32,
            num_consumed: 1,
        };
    } else {
        var c1 = c as u32;
        var c2 = slice[1] as u32;

        if c1 > 0xDBFF || c2 < 0xDC00 || c2 > 0xDFFF {
            panic("invalid utf-16 sequence");
        }

        var value = ((c1 - 0xD800) << 10) | (c2 - 0xDC00);

        return DecodeResult {
            codepoint: 0x10000 + value,
            num_consumed: 2,
        };
    }
}

pub func validate_utf8(slice: Slice[u8]) -> bool {
    # For reference: https://unicode.org/mail-arch/unicode-ml/y2003-m02/att-0467/01-The_Algorithm_to_Valide_an_UTF-8_String

    var index: usize = 0;

    while index < slice.length() {
        var c1 = slice[index];

        if c1 & 0x80 == 0 {
            index += 1;
        } else if c1 & 0xE0 == 0xC0 {
            if index + 1 >= slice.length() {
                return false;
            }

            var c2 = slice[index + 1];

            if c2 & 0xC0 != 0x80 {
                return false;
            }

            # Non-shortest forms are illegal.
            if c1 == 0xC0 || c1 == 0xC1 {
                return false;
            }

            index += 2;
        } else if c1 & 0xF0 == 0xE0 {
            if index + 2 >= slice.length() {
                return false;
            }

            var c2 = slice[index + 1];
            var c3 = slice[index + 2];

            if c2 & 0xC0 != 0x80 || c3 & 0xC0 != 0x80 {
                return false;
            }

            # Non-shortest forms are illegal.
            if c1 == 0xE0 && c2 < 0xA0 {
                return false;
            }

            # Encoding surrogates is illegal.
            if c1 == 0xED && c2 > 0x99 {
                return false;
            }

            index += 3;
        } else if c1 & 0xF8 == 0xF0 {
            if index + 3 >= slice.length() {
                return false;
            }

            var c2 = slice[index + 1];
            var c3 = slice[index + 2];
            var c4 = slice[index + 3];

            if c2 & 0xC0 != 0x80 || c3 & 0xC0 != 0x80 || c4 & 0xC0 != 0x80 {
                return false;
            }

            # Non-shortest forms are illegal.
            if c1 == 0xF0 && c2 < 0x90 {
                return false;
            }

            # Encoding values larger than U+10FFFF is illegal.
            if (c1 == 0xF4 && c2 > 0x8F) || c1 > 0xF4 {
                return false;
            }

            index += 4;
        } else {
            return false;
        }
    }

    return true;
}

pub func is_utf8_char_boundary(c: u8) -> bool {
    return c & 0x80 == 0 || c & 0xC0 == 0xC0;
}
