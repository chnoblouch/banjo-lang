use std.{
    memory.{PointerMoveIter, PointerRefIter},
    protos.{Compare, ToRepr, ToString},
    convert,
};

use internal.std_panics.{panic_out_of_bounds_array, panic_cannot_compare_slice};

struct Slice[T]: Compare[Slice[T]], ToString, ToRepr {
    var data: *T;
    var length: usize;

    pub func new(data: *T, length: usize) -> Slice[T] {
        return Slice[T] { data, length };
    }

    pub func new_empty() -> Slice[T] {
        return Slice[T] {
            data: null,
            length: 0,
        };
    }

    pub func data(self) -> *T {
        return self.data;
    }

    pub func length(self) -> usize {
        return self.length;
    }

    pub func as_bytes(self) -> Slice[u8] {
        return Slice[u8] {
            data: self.data as *u8,
            length: self.length * meta(T).size,
        };
    }

    pub func subslice(mut self, start: usize, end: usize) -> Slice[T] {
        return Slice[T] {
            data: &self.data[start],
            length: end - start,
        };
    }

    pub func __index__(self, index: usize) -> ref T {
        self.check_bounds(index);
        return self.data[index];
    }

    pub func __mutindex__(mut self, index: usize) -> ref mut T {
        self.check_bounds(index);
        return self.data[index];
    }

    pub func __refiter__(self) -> PointerRefIter[T] {
        return PointerRefIter[T].new(self.data, self.data + self.length);
    }

    pub func __mutiter__(mut self) -> PointerRefIter[T] {
        return PointerRefIter[T].new(self.data, self.data + self.length);
    }

    pub func __eq__(self, ref rhs: Slice[T]) -> bool {
        if T is Compare[T] {
            if self.length != rhs.length {
                return false;
            }

            for i in 0..self.length {
                if self.data[i] != rhs.data[i] {
                    return false;
                }
            }

            return true;
        } else {
            panic_cannot_compare_slice();
            return false;
        }
    }

    pub func __ne__(self, ref rhs: Slice[T]) -> bool {
        return !(self == rhs);
    }

    pub func __str__(self) -> String {
        return self.__repr__(0);
    }

    pub func __repr__(self, indent: u32) -> String {
        if T == u8 {
            return "[<data>]";
        }

        var string = "[\n";

        for i in 0..self.length {
            for j in 0..indent + 1 {
                string.append("  ");
            }

            string.append(convert.to_repr_indent(self.data[i], indent + 1));
            string.append(",\n");
        }

        for i in 0..indent {
            string.append("  ");
        }

        string.append(']');
        return string;
    }

    func check_bounds(self, index: usize) {
        if index >= self.length {
            panic_out_of_bounds_array(index, self.length);
        }
    }
}
