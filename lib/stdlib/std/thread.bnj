use std.{platform, memory, sync.Mutex};
use internal.std_panics.panic_thread_not_joined;

struct Thread {
    var handle: usize;
    var joined: Mutex[bool];

    pub func spawn(target: ||) -> Thread {
        var argument = memory.box(target) as addr;
        var handle = platform.thread_spawn(initializer, argument);
        
        return Thread {
            handle,
            joined: Mutex[bool].new(false),
        };
    }

    pub func __deinit__(mut self) {
        if !self.joined.lock().value {
            panic_thread_not_joined();
        }
    }

    pub func join(move self) {
        platform.thread_join(self.handle);
        self.joined.lock().value = true;
    }

    func initializer(data: addr) {
        var target = data as *||;
        (*target)();
        memory.free(data);
    }
}

pub func sleep(milliseconds: u32) {
    platform.thread_sleep(milliseconds);
}

pub func hardware_concurrency() -> u32 {
    return platform.thread_hardware_concurrency();
}
