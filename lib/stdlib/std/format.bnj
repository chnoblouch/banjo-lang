use std.convert;
use internal.std_panics.panic_invalid_format_template;

pub func format[Args: ...](template: StringSlice, args: Args) -> String {
    return format_packed(template, args);
}

func format_packed[Args](template: StringSlice, args: Args) -> String {
    var result = "";
    var index: usize = 0;

    meta for arg in args {
        var substring = template.substring(index, template.length());

        var lbrace = substring.find('{');
        var rbrace = substring.find('}');

        if !lbrace.has_value || !rbrace.has_value {
            panic_invalid_format_template();
        }

        index += rbrace.value + 1;
        result += substring.substring(0, lbrace.value);
        result += format_arg(substring.substring(lbrace.value, rbrace.value + 1), ref arg);
    }

    if index < template.length() {
        var substring = template.substring(index, template.length());

        if substring.find('{').has_value || substring.find('}').has_value {
            panic_invalid_format_template();
        }

        result += substring;
    }

    return result;
}

func format_arg[T](format: StringSlice, arg: ref T) -> String {
    var base: u64 = 10;
    var upper: bool = false;
    var width: usize = 0;
    var padding_char: u8 = ' ';

    var parsing_format: bool = false;
    var base_set: bool = false;
    var width_set: bool = false;
    var padding_char_set: bool = false;

    for i in 1..format.length() - 1 {
        var c = format.data[i] as u8;
        
        if parsing_format {
            if c == 'b' && !base_set {
                base = 2;
                base_set = true;
            } else if c == 'o' && !base_set {
                base = 8;
                base_set = true;
            } else if c == 'x' && !base_set {
                base = 16;
                base_set = true;
            } else if c == 'X' && !base_set {
                base = 16;
                upper = true;
                base_set = true;
            } else if c == '0' && !padding_char_set {
                padding_char = '0';
                padding_char_set = true;
            } else if c >= '1' && c <= '9' && !width_set {
                var start_index = i;
                i += 1;

                while format.data[i] >= '0' && format.data[i] <= '9' {
                    i += 1;
                }

                var substring = format.substring(start_index, i);
                width = convert.parse_u64(substring).unwrap() as usize;
                width_set = true;
            } else {
                panic_invalid_format_template();
            }
        } else {
            if c == ':' {
                parsing_format = true;
            } else {
                panic_invalid_format_template();
            }
        }
    }

    var string: String;
    var is_number = false;

    if T == i8 {
        string = convert.i64_to_string(arg as i64, base, upper);
        is_number = true;
    } else if T == i16 {
        string = convert.i64_to_string(arg as i64, base, upper);
        is_number = true;
    } else if T == i32 {
        string = convert.i64_to_string(arg as i64, base, upper);
        is_number = true;
    } else if T == i64 {
        string = convert.i64_to_string(arg as i64, base, upper);
        is_number = true;
    } else if T == u16 {
        string = convert.u64_to_string(arg as u64, base, upper);
        is_number = true;
    } else if T == u32 {
        string = convert.u64_to_string(arg as u64, base, upper);
        is_number = true;
    } else if T == u64 {
        string = convert.u64_to_string(arg as u64, base, upper);
        is_number = true;
    } else if T == usize {
        string = convert.u64_to_string(arg as u64, base, upper);
        is_number = true;
    } else {
        string = convert.to_string(arg);
    }

    if string.length() >= width {
        return string;
    } else {
        var result = "";

        if is_number && padding_char == '0' && string.slice.data[0] == '-' {
            result = "-";
        }

        for i in 0..width - string.length() {
            result.append(padding_char as char);
        }

        if result.slice.data[0] == '-' {
            result.append(string.slice().substring(1, string.length()));
        } else {
            result.append(string);
        }

        return result;
    }
}
