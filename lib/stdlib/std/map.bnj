use std.{convert, protos.{Copy, Compare, ToRepr, ToString}};
use internal.std_panics.{panic_cannot_find_key_map, panic_cannot_copy_map};

struct Map[K: Compare[K], V]: Copy, ToString, ToRepr {
    var elements: Array[(K, V)];

    pub func new() -> Map[K, V] {
        return Map[K, V] {
            elements: [],
        };
    }

    pub func from(slice: Slice[(K, V)]) -> Map[K, V] {
        return Map[K, V] {
            elements: Array[(K, V)].from(slice),
        };
    }

    pub func __make__(pointer: *(K, V), length: usize) -> Map[K, V] {
        return from(Slice[(K, V)].new(pointer, length));
    }

    pub func insert(mut self, key: K, value: V) {
        self.elements.append((key, value));
    }

    pub func contains(self, ref key: K) -> bool {
        for ref element in self.elements {
            if element.0 == key {
                return true;
            }
        }

        return false;
    }

    pub func copy(self) -> Map[K, V] {
        var elements = Array[(K, V)].sized(self.elements.length());

        if K is Copy {
            if V is Copy {
                for i in 0..self.elements.length() {
                    var element = ref self.elements[i];
                    elements[i] = ((element.0).copy(), (element.1).copy());
                }
            } else {
                panic_cannot_copy_map[V]();
            }
        } else {
            panic_cannot_copy_map[K]();
        }

        return Map[K, V] { elements };
    }

    pub func __index__(mut self, ref key: K) -> ref mut V {
        for ref mut element in self.elements {
            if element.0 == key {
                return ref mut element.1;
            }
        }

        panic_cannot_find_key_map(key);
        return undefined;
    }

    pub func try_get(mut self, ref key: K) -> ?ref mut V {
        for ref mut element in self.elements {
            if element.0 == key {
                return ref mut element.1;
            }
        }

        return none;
    }

    pub func length(self) -> usize {
        return self.elements.length();
    }

    pub func __str__(self) -> String {
        return self.__repr__(0);
    }

    pub func __repr__(self, indent: u32) -> String {
        var string = "[\n";

        for i in 0..self.elements.length() {
            for j in 0..indent + 1 {
                string += "  ";
            }

            string.append(convert.to_repr_indent(self.elements[i].0, indent + 1));
            string.append(": ");
            string.append(convert.to_repr_indent(self.elements[i].1, indent + 1));
            string.append(",\n");
        }

        for i in 0..indent {
            string += "  ";
        }

        string.append(']');
        return string;
    }
}
