use std.memory;

struct Data[T] {
    var value: T;
    var ref_count: u32;
}

struct Shared[T] {
    var data: *Data[T];

    pub func new(value: T) -> Shared[T] {
        var data = memory.alloc(meta(T).size) as *Data[T];
        *data = Data[T] { value, ref_count: 1 };
        return Shared[T] { data };
    }

    pub func get(self) -> *T {
        return &self.data.value;
    }

    pub func copy(self) -> Shared[T] {
        self.data.ref_count += 1;
        return Shared[T] { data: self.data };
    }

    pub func __deref__(mut self) -> ref mut T {
        return self.data.value;
    }

    pub func __deinit__(self) {
        self.data.ref_count -= 1;

        if self.data.ref_count == 0 {
            __builtin_deinit(self.data.value);
            memory.free(self.data);
        }
    }
}
