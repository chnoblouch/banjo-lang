use std.{io, memory, math};

struct Cursor: io.Read, io.Write, io.Seek {
    var data: Slice[u8];
    var position: usize;

    pub func new(data: Slice[u8]) -> Cursor {
        return Cursor {
            data,
            position: 0,
        };
    }

    pub func read(mut self, data: Slice[u8]) -> usize except io.Error {
        var size = math.min(self.position + data.length, self.data.length) - self.position;
        memory.copy(&self.data[self.position], data.data, size);
        self.position += size;
        
        return size;
    }

    pub func write(mut self, data: Slice[u8]) -> usize except io.Error {
        var size = math.min(self.position + data.length, self.data.length) - self.position;
        memory.copy(data.data, &self.data[self.position], size);
        self.position += size;

        return size;
    }

    pub func position(self) -> u64 except io.Error {
        return self.position as u64;
    }

    pub func seek(mut self, offset: i64, origin: io.Seek.Origin) -> void except io.Error {
        # TODO: Check non-negative
        
        var reference: usize = undefined;
        
        if origin == .START {
            reference = 0;
        } else if origin == .END {
            reference = self.data.length() - 1;
        } else if origin == .CURRENT {
            reference = self.position;
        }

        if offset >= 0 {
            self.position = reference + offset as usize;
        } else {
            self.position = reference - (-offset as usize);
        }
    }
}
