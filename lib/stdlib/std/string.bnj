use std.{
    memory,
    protos.{Compare, Copy, ToRepr, ToString},
    unicode,
};

struct String: Copy, Compare[String], ToString, ToRepr {
    var slice: StringSlice;
    var capacity: usize;

    pub func new() -> String {
        return String {
            slice: StringSlice.new_empty(),
            capacity: 0,
        };
    }

    pub func from(slice: StringSlice) -> String {
        var data = memory.alloc(slice.length) as *u8;
        memory.copy(slice.data, data, slice.length);

        return String {
            slice: StringSlice {
                data,
                length: slice.length,
            },
            capacity: slice.length,
        };
    }

    pub func from_chars(slice: Slice[char]) -> String {
        var bytes: Array[u8] = [];
        
        for i in 0..slice.length() {
            var utf8 = unicode.encode_utf8(slice[i]);

            for i in 0..utf8.length {
                bytes.append(utf8.bytes[i]);
            }
        }

        return from(StringSlice.new(bytes.data(), bytes.length()));
    }

    pub func from_utf16(slice: Slice[u16]) -> String {
        var bytes: Array[u8] = [];
        var index: usize = 0;

        while index < slice.length() {
            var decoded = unicode.decode_utf16(slice.subslice(index, slice.length()));
            var utf8 = unicode.encode_utf8(decoded.codepoint);

            for i in 0..utf8.length {
                bytes.append(utf8.bytes[i]);
            }

            index += decoded.num_consumed;
        }

        return from(StringSlice.new(bytes.data(), bytes.length()));
    }

    pub func from_cstring(data: *u8) -> String {
        return from(StringSlice.of_cstring(data));
    }

    func __internal_make(pointer: *u8, length: usize) -> String {
        return from(StringSlice.__internal_make(pointer, length));
    }

    pub func __deinit__(mut self) {
        memory.free(self.slice.data);
    }

    pub func slice(self) -> StringSlice {
        return self.slice;
    }

    pub func bytes(self) -> *u8 {
        return self.slice.data;
    }

    pub func length(self) -> usize {
        return self.slice.length;
    }

    pub func copy(self) -> String {
        return String.from(self.slice);
    }

    pub func append(mut self, slice: StringSlice) {
        var new_length = self.slice.length + slice.length;
        self.ensure_capacity(new_length);
        memory.copy(slice.data, &self.slice.data[self.slice.length], slice.length);
        self.slice.length = new_length;
    }

    pub func append(mut self, c: char) {
        self.append(unicode.encode_utf8(c).slice());
    }

    pub func append(mut self, other: String) {
        self.append(other.slice);
    }

    pub func at(self, index: usize) -> char {
        return self.slice.at(index);
    }

    pub func substring(self, start: usize, end: usize) -> String {
        return String.from(self.slice.substring(start, end));
    }

    pub func starts_with(self, other: StringSlice) -> bool {
        return self.slice.starts_with(other);
    }

    pub func ends_with(self, other: StringSlice) -> bool {
        return self.slice.ends_with(other);
    }

    pub func find(self, c: char) -> ?usize {
        return self.slice.find(c);
    }

    pub func find(self, string: StringSlice) -> ?usize {
        return self.slice.find(string);
    }

    pub func rfind(self, c: char) -> ?usize {
        return self.slice.rfind(c);
    }

    pub func rfind(self, string: StringSlice) -> ?usize {
        return self.slice.rfind(string);
    }

    pub func split(self, c: char) -> Array[StringSlice] {
        return self.slice.split(c);
    }

    pub func split(self, string: StringSlice) -> Array[StringSlice] {
        return self.slice.split(string);
    }

    pub func split_skipping(self, c: char) -> Array[StringSlice] {
        return self.slice.split_skipping(c);
    }

    pub func split_skipping(self, string: StringSlice) -> Array[StringSlice] {
        return self.slice.split_skipping(string);
    }

    pub func to_chars(self) -> Array[char] {
        var chars: Array[char] = [];
        var index: usize = 0;

        while index < self.length() {
            var slice = Slice[u8].new(self.slice.pointer(index), self.slice.length - index);
            var decoded = unicode.decode_utf8(slice);
            
            chars.append(decoded.codepoint);
            index += decoded.num_consumed;
        }

        return chars;
    }

    pub func to_utf16(self) -> Array[u16] {
        return self.slice.to_utf16();
    }

    pub func to_cstring(self) -> Array[u8] {
        return self.slice.to_cstring();
    }

    pub func __add__(self, ref rhs: String) -> String {
        var copy = self.copy();
        copy.append(rhs.copy());
        return copy;
    }

    pub func __add__(self, ref rhs: StringSlice) -> String {
        var copy = self.copy();
        copy.append(rhs);
        return copy;
    }

    pub func __add__(self, rhs: char) -> String {
        var copy = self.copy();
        copy.append(rhs);
        return copy;
    }

    # pub func __eq__(self, rhs: StringSlice) -> bool {
    #     return self.slice == rhs;
    # }

    pub func __eq__(self, ref rhs: String) -> bool {
        return self.slice == rhs.slice;
    }

    # pub func __ne__(self, rhs: StringSlice) -> bool {
    #     return self.slice != rhs;
    # }

    pub func __ne__(self, ref rhs: String) -> bool {
        return self.slice != rhs.slice;
    }

    pub func __str__(self) -> String {
        return self.slice.__str__();
    }

    pub func __repr__(self, indent: u32) -> String {
        return self.slice.__repr__(indent);
    }

    pub func __hash__(self) -> u64 {
        return self.slice.__hash__();
    }

    func ensure_capacity(mut self, capacity: usize) {
        if self.capacity >= capacity {
            return;
        }

        if self.capacity == 0 {
            self.capacity = capacity;
        } else {
            while self.capacity < capacity {
                self.capacity = 2 * self.capacity;
            }
        }

        self.slice.data = memory.realloc(self.slice.data, self.capacity) as *u8;
    }

    func reverse_in_place(mut self) {
        for i1 in 0..self.slice.length / 2 {
            var i2 = self.slice.length - 1 - i1;

            var c1 = self.slice.data[i1];
            var c2 = self.slice.data[i2];

            self.slice.data[i1] = c2;
            self.slice.data[i2] = c1;
        }
    }
}
