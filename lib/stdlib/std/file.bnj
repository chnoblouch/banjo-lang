use std.{
    platform,
    path.Path,
    io.{Read, Write, Seek, Error},
};

struct File: Read, Write, Seek {
    enum Mode {
        OPEN,
        OPEN_OR_CREATE,
        CREATE,
        CREATE_NEW,
        TRUNCATE,
        APPEND,
    }

    enum Access {
        READ,
        WRITE,
        READ_WRITE,
    }

    var handle: platform.File;

    pub func open[PathLike: Path | String | StringSlice | *u8](
        path: PathLike,
        mode: Mode,
        access: Access,
    ) -> File except Error {
        var path_string = Path.from(path).str();

        try handle in platform.file_open(path_string.slice, mode, access) {
            return File { handle };   
        } except error: platform.ErrorCode {
            return Error.from_platform(error);
        }
    }

    pub func read_all[PathLike: Path | String | StringSlice | *u8](path: PathLike) -> Array[u8] except Error {
        var file = try open(path, .OPEN, .READ);
        var position = try file.seek(0, .END);
        var size = try file.position() as usize;
        position = try file.seek(0, .START);

        var buffer = Array[u8].sized(size);
        try file.read_full(buffer.slice);
        return buffer;
    }

    pub func read_all_string[PathLike: Path | String | StringSlice | *u8](path: PathLike) -> String except Error {
        # TODO: Unnecessary copy
        
        var buffer = try File.read_all(path);
        return String.from(StringSlice.new(buffer.data(), buffer.length()));
    }

    pub func read(mut self, data: Slice[u8]) -> usize except Error {
        try count in platform.file_read(self.handle, data) {
            return count;
        } except error: platform.ErrorCode {
            return Error.from_platform(error);
        }
    }

    pub func write(mut self, data: Slice[u8]) -> usize except Error {
        try count in platform.file_write(self.handle, data) {
            return count;
        } except error: platform.ErrorCode {
            return Error.from_platform(error);
        }
    }

    pub func position(self) -> u64 except Error {
        try position in platform.file_position(self.handle) {
            return position;
        } except error: platform.ErrorCode {
            return Error.from_platform(error);
        }
    }

    pub func seek(mut self, offset: i64, origin: Seek.Origin) -> u64 except Error {
        try position in platform.file_seek(self.handle, offset, origin) {
            return position;
        } except error: platform.ErrorCode {
            return Error.from_platform(error);
        }
    }

    func __deinit__(self) {
        platform.file_close(self.handle);
    }
}
