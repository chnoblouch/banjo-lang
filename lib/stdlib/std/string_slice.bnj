use std.{
    memory,
    protos.{Compare, ToRepr, ToString},
    unicode,
};

use libc as c;

use internal.std_panics.{
    panic_invalid_utf8,
    panic_out_of_bounds_string,
    panic_utf8_not_at_boundary,
};

struct StringSlice: Compare[StringSlice], ToString, ToRepr {
    var data: *u8;
    var length: usize;

    pub func new(data: *u8, length: usize) -> StringSlice {
        if !unicode.validate_utf8(Slice[u8].new(data, length)) {
            panic_invalid_utf8();
        }

        return StringSlice { data, length };
    }

    pub func new_empty() -> StringSlice {
        return StringSlice {
            data: null,
            length: 0,
        };
    }

    pub func of_cstring(data: *u8) -> StringSlice {
        var length = c.strlen(data);

        if !unicode.validate_utf8(Slice[u8].new(data, length)) {
            panic_invalid_utf8();
        }

        return StringSlice { data, length };
    }

    func __internal_make(pointer: *u8, length: usize) -> StringSlice {
        return StringSlice { data: pointer, length };
    }

    pub func data(self) -> *u8 {
        return self.data;
    }

    pub func length(self) -> usize {
        return self.length;
    }

    pub func substring(self, start: usize, end: usize) -> StringSlice {
        self.check_index(start);
        self.check_end_index(end);
        
        return StringSlice {
            data: self.pointer(start),
            length: end - start,
        };
    }

    pub func starts_with(self, other: StringSlice) -> bool {
        if self.length < other.length {
            return false;
        }

        return memory.compare(self.data, other.data, other.length);
    }

    pub func ends_with(self, other: StringSlice) -> bool {
        if self.length < other.length {
            return false;
        }

        return memory.compare(self.pointer(self.length - other.length), other.data, other.length);
    }

    pub func find(self, char: u8) -> ?usize {
        for i in 0..self.length {
            if self.data[i] == char {
                return i;
            }
        }

        return none;
    }

    pub func rfind(self, char: u8) -> ?usize {
        var i = self.length - 1;

        while i >= 0 {
            if self.data[i] == char {
                return i;
            }

            if i == 0 {
                break;
            }

            i -= 1;
        }

        return none;
    }

    pub func find(self, substr: StringSlice) -> ?usize {
        if substr.length > self.length {
            return none;
        }

        var i: usize = 0;

        while i <= self.length - substr.length {
            if self.data[i] == substr.data[0] {
                var j: usize = 1;
                var matching = true;

                while j < substr.length {
                    if self.data[i + j] != substr.data[j] {
                        matching = false;
                    }

                    j = j + 1;
                }

                if matching {
                    return i;
                }
            }

            i = i + 1;
        }

        return none;
    }

    pub func to_cstring(self) -> Array[u8] {
        var size = self.length + 1;
        var data = memory.alloc(size) as *u8;
        memory.copy(self.data, data, self.length);
        data[self.length] = '\0';

        return Array[u8] {
            slice: Slice[u8].new(data, size),
            capacity: size,
        };
    }

    pub func to_utf16(self) -> Array[u16] {
        var slice = Slice[u8].new(self.data, self.length);

        var result: Array[u16] = [];
        var index: usize = 0;

        while index < self.length {
            var decoded = unicode.decode_utf8(slice.subslice(index, slice.length()));
            var utf16 = unicode.encode_utf16(decoded.codepoint);

            for i in 0..utf16.length {
                result.append(utf16.values[i]);
            }

            index += decoded.num_consumed;
        }

        return result;
    }

    pub func __eq__(self, ref rhs: StringSlice) -> bool {
        if self.length != rhs.length {
            return false;
        }

        return memory.compare(self.data, rhs.data, self.length);
    }

    pub func __ne__(self, ref rhs: StringSlice) -> bool {
        return !(self == rhs);
    }

    pub func __index__(self, index: usize) -> ref u8 {
        self.check_index(index);
        return self.data[index];
    }

    pub func __mutindex__(mut self, index: usize) -> ref mut u8 {
        self.check_index(index);
        return self.data[index];
    }

    pub func __str__(self) -> String {
        return String.from(self);
    }

    pub func __repr__(self, indent: u32) -> String {
        var result = "\"";

        for i in 0..self.length {
            var char = self.data[i];

            if char == '\n' {
                result.append('\\');
                result.append('n');
            } else if char == '\r' {
                result.append('\\');
                result.append('r');
            } else if char == '\t' {
                result.append('\\');
                result.append('t');
            } else {
                result.append(char);
            }
        }

        result.append('\"');

        return result;
    }

    pub func __hash__(self) -> u64 {
        # www.cse.yorku.ca/~oz/hash.html

        var hash: u64 = 5381;

        for i in 0..self.length {
            hash = ((hash << 5) + hash) + self.data[i] as u64;
        }

        return hash;
    }

    func pointer(self, index: usize) -> *u8 {
        return __builtin_pointer_to(self.data[index]);
    }

    func check_index(self, index: usize) {
        if index >= self.length {
            panic_out_of_bounds_string(index, self.length);
        }

        var c = self.data[index];

        if !unicode.is_utf8_char_boundary(c) {
            panic_utf8_not_at_boundary(index);
        }
    }

    func check_end_index(self, index: usize) {
        if index == self.length {
            return;
        }

        if index > self.length {
            panic_out_of_bounds_string(index, self.length);
        }

        var c = self.data[index];

        if !unicode.is_utf8_char_boundary(c) {
            panic_utf8_not_at_boundary(index);
        }
    }
}
