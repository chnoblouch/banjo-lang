use os.{IS_WINDOWS, winapi};
use std.{memory, io, unicode, convert.to_string, math.{min, max}};

meta if IS_WINDOWS {
    type ErrorCode = winapi.Dword;
    type Mutex = winapi.Handle;
    type Socket = winapi.Socket;

    const SOCKET_INVALID: Socket = winapi.INVALID_SOCKET;
    const SOCKET_ADDRESS_FAMILY_IPV4: i32 = winapi.AF_INET;
    const SOCKET_ADDRESS_FAMILY_IPV6: i32 = winapi.AF_INET6;
    const SOCKET_TYPE_STREAM: i32 = winapi.SOCK_STREAM;
    const SOCKET_TYPE_DATAGRAM: i32 = winapi.SOCK_DGRAM;
    const SOCKET_PROTOCOL_TCP: i32 = winapi.IPPROTO_TCP;
    const SOCKET_PROTOCOL_UDP: i32 = winapi.IPPROTO_UDP;

    struct StdioStream {
        var handle: winapi.Handle;
        var buffer: [u8; 4];
        var buffer_size: usize;
    }

    var wsa_initialized: bool = false;

    pub func error_last() -> ErrorCode {
        return winapi.get_last_error();
    }

    pub func error_kind(error: ErrorCode) -> io.Error.Kind {
        if error == winapi.ERROR_FILE_NOT_FOUND {
            return .NOT_FOUND;
        } else if error == winapi.ERROR_ACCESS_DENIED {
            return .PERMISSION_DENIED;
        } else if error == winapi.ERROR_ALREADY_EXISTS {
            return .ALREADY_EXISTS;
        } else {
            return .UNKNOWN;
        }
    }

    pub func error_message(error: ErrorCode) -> String {
        var buffer: *u8 = null;

        var length = winapi.format_message(
            winapi.FORMAT_MESSAGE_ALLOCATE_BUFFER | winapi.FORMAT_MESSAGE_FROM_SYSTEM | winapi.FORMAT_MESSAGE_IGNORE_INSERTS,
            null,
            error,
            0x400,  # MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT)
            &buffer,
            0,
            null
        );

        var trimmed_length = length as usize - 3;
        var string = String.from(StringSlice.new(buffer, trimmed_length));
        winapi.local_free(buffer);

        return string;
    }

    pub func io_get_stdin_stream() -> StdioStream {
        return StdioStream {
            handle: winapi.get_std_handle(winapi.STD_INPUT_HANDLE),
            buffer: undefined,
            buffer_size: 0,
        };
    }

    pub func io_get_stdout_stream() -> StdioStream {
        return StdioStream {
            handle: winapi.get_std_handle(winapi.STD_OUTPUT_HANDLE),
            buffer: undefined,
            buffer_size: 0,
        };
    }

    pub func io_get_stderr_stream() -> StdioStream {
        return StdioStream {
            handle: winapi.get_std_handle(winapi.STD_ERROR_HANDLE),
            buffer: undefined,
            buffer_size: 0,
        };
    }

    pub func io_stdio_read(stream: *StdioStream, data: Slice[u8]) -> usize except ErrorCode {
        if stream.handle == null || stream.handle == winapi.INVALID_HANDLE_VALUE || data.length == 0 {
            return 0 as usize;
        }

        if !is_console(stream.handle) {
            return read_file(stream.handle, data);
        }

        var size: usize = 0;
        var returned_bytes = min(data.length, stream.buffer_size);
        var buffered_bytes = stream.buffer_size - returned_bytes;

        # Take as many bytes as possible from the UTF-8 buffer and return them.
        memory.copy(&stream.buffer[0], &data[0], returned_bytes);
        memory.copy(&stream.buffer[returned_bytes], &stream.buffer[0], buffered_bytes);

        size += returned_bytes;
        stream.buffer_size = buffered_bytes;

        # Return if the UTF-8 buffer was large enough to fill the output buffer.
        if size == data.length {
            return size;
        }

        # The maximum number of UTF-8 bytes per UTF-16 value is 3.
        # We also want to read at least one character even if there is not
        # enough space in the output buffer because we can put the bytes into
        # the internal UTF-8 buffer.
        var utf16_values_to_read = max((data.length - size) / 3, 1 as usize);

        var utf16_buffer = Array[u16].sized(utf16_values_to_read);
        var utf16_values_read = try read_console_utf16(stream.handle, utf16_buffer.slice());
        utf16_buffer.resize(utf16_values_read);

        if utf16_buffer.length() == 0 {
            return size;
        }

        var last_utf16_value: u16 = utf16_buffer[utf16_buffer.length() - 1];

        # If the read UTF-16 data ends with an unpaired surrogate, read one more
        # value to complete it.
        if last_utf16_value >= 0xD800 && last_utf16_value <= 0xDBFF {
            var surrogate_buffer: Slice[u16] = [0];
            utf16_values_read = try read_console_utf16(stream.handle, surrogate_buffer);

            if utf16_values_read != 0 {
                utf16_buffer.append(surrogate_buffer[0]);
            }
        }

        var index: usize = 0;

        while index < utf16_buffer.length() {
            var utf16_slice = utf16_buffer.slice().subslice(index, utf16_buffer.length());
            var decoded = unicode.decode_utf16(utf16_slice);
            var utf8 = unicode.encode_utf8(decoded.codepoint);

            var returned_bytes = min(utf8.length, data.length - size);
            var buffered_bytes = utf8.length - returned_bytes;

            # Return as many bytes as possible. If the number of bytes is larger
            # than the output buffer, put the remaining bytes into the internal
            # UTF-8 buffer.
            memory.copy(&utf8.bytes[0], &data[0], returned_bytes);
            memory.copy(&utf8.bytes[returned_bytes], &stream.buffer[0], buffered_bytes);

            index += decoded.num_consumed;
            size += returned_bytes;
            stream.buffer_size = buffered_bytes;
        }

        return size;
    }

    pub func io_stdio_write(stream: *StdioStream, data: Slice[u8]) -> usize except ErrorCode {
        if stream.handle == null || stream.handle == winapi.INVALID_HANDLE_VALUE || data.length == 0 {
            return 0 as usize;
        }

        var console_mode: winapi.Dword = undefined;
        var bytes_written: winapi.Dword = undefined;

        if !is_console(stream.handle) {
            return write_file(stream.handle, data);
        }

        var string = StringSlice.new(data.data, data.length);
        var data_utf16 = string.to_utf16();

        try result in write_console_utf16(stream.handle, data_utf16.slice()) {
            # TODO: Calculate to actual number of bytes written.
            return data.length;
        } except error: ErrorCode {
            return error;
        }
    }

    pub func path_canonical(path: StringSlice) -> String except ErrorCode {
        var handle = winapi.create_file(
            path.to_cstring().data(),
            0,
            0,
            null,
            winapi.OPEN_EXISTING,

            # This flag allows us to open directories.
            winapi.FILE_FLAG_BACKUP_SEMANTICS,
            
            null,
        );

        if handle == winapi.INVALID_HANDLE_VALUE {
            return error_last();
        }

        var buffer = memory.alloc(winapi.MAX_PATH as usize) as *u8;

        var result = winapi.get_final_path_name_by_handle(
            handle,
            &buffer[0],
            winapi.MAX_PATH,
            winapi.FILE_NAME_NORMALIZED | winapi.VOLUME_NAME_DOS,
        );

        winapi.close_handle(handle);

        if result == 0 {
            return error_last();
        }

        var slice = StringSlice.of_cstring(&buffer[0]);

        if slice.starts_with("\\\\?\\") || slice.starts_with("\\\\.\\") {
            slice = slice.substring(4, slice.length());
        }

        var string = String.from(slice);
        memory.free(buffer);

        return string;
    }

    pub func path_exists(path: *String) -> bool except ErrorCode {
        var attributes = winapi.get_file_attributes(path.to_cstring().data());

        if attributes != winapi.INVALID_FILE_ATTRIBUTES {
            return true;
        } else {
            var error = error_last();

            if error == winapi.ERROR_FILE_NOT_FOUND {
                return false;
            } else {
                return error;
            }
        }
    }

    pub func path_is_file(path: *String) -> bool except ErrorCode {
        # For reference: https://github.com/microsoft/STL/blob/6d253467512d9a4295fdf25fa6fc92f898c9d52c/stl/inc/filesystem#L1992

        var attributes = winapi.get_file_attributes(path.to_cstring().data());

        if attributes != winapi.INVALID_FILE_ATTRIBUTES {
            return (attributes & winapi.FILE_ATTRIBUTE_DIRECTORY) == 0;
        } else {
            return error_last();
        }
    }

    pub func path_is_dir(path: *String) -> bool except ErrorCode {
        # For reference: https://github.com/microsoft/STL/blob/6d253467512d9a4295fdf25fa6fc92f898c9d52c/stl/inc/filesystem#L1992

        var attributes = winapi.get_file_attributes(path.to_cstring().data());

        if attributes != winapi.INVALID_FILE_ATTRIBUTES {
            return (attributes & winapi.FILE_ATTRIBUTE_DIRECTORY) != 0;
        } else {
            return error_last();
        }
    }

    pub func path_list_dir(path: *String) -> Array[String] except ErrorCode {
        # For reference: https://learn.microsoft.com/en-us/windows/win32/fileio/listing-the-files-in-a-directory

        var pattern = path.copy() + "\\*";
        var find_data: winapi.Win32FindData;

        var handle = winapi.find_first_file(pattern.to_cstring().data(), &find_data);
        if handle == winapi.INVALID_HANDLE_VALUE {
            return error_last();
        }

        var file_names: Array[String] = [];
        var more_paths = true;

        while more_paths {
            var file_name_string = String.from_cstring(&find_data.file_name[0]);

            if file_name_string != "." && file_name_string != ".." {
                file_names.append(file_name_string);
            }

            more_paths = winapi.find_next_file(handle, &find_data) != 0;
        }

        var error = error_last();
        winapi.find_close(handle);

        if error == winapi.ERROR_NO_MORE_FILES {
            return file_names;
        } else {
            return error;
        }
    }

    pub func path_create_dir(path: *String) -> void except ErrorCode {
        var result = winapi.create_directory(path.to_cstring().data(), null);
        if result == 0 {
            return error_last();
        }
    }

    pub func path_remove_file(path: *String) -> void except ErrorCode {
        var result = winapi.delete_file(path.to_cstring().data());
        if result == 0 {
            return error_last();
        }
    }

    pub func path_remove_dir(path: *String) -> void except ErrorCode {
        var result = winapi.remove_directory(path.to_cstring().data());
        if result == 0 {
            return error_last();
        }
    }

    pub func thread_spawn(function: func(addr), argument: addr) -> usize {
        var handle = winapi.create_thread(null, 0, function, argument, 0, null);
        return handle as usize;
    }

    pub func thread_join(handle: usize) {
        winapi.wait_for_single_object(handle as addr, 0xFFFFFFFF);
    }

    pub func thread_close(handle: usize) {
        winapi.close_handle(handle as addr);
    }

    pub func thread_sleep(milliseconds: u32) {
        winapi.sleep(milliseconds);
    }

    pub func thread_hardware_concurrency() -> u32 {
        var system_info: winapi.SystemInfo;
        winapi.get_native_system_info(&system_info);
        return system_info.number_of_processors;
    }

    pub func mutex_create() -> Mutex {
        return winapi.create_mutex(null, winapi.FALSE, null);
    }

    pub func mutex_lock(mutex: Mutex) {
        var result = winapi.wait_for_single_object(mutex, winapi.INFINITE);
        if result != winapi.WAIT_OBJECT_0 {
            panic("failed to lock mutex");
        }
    }

    pub func mutex_unlock(mutex: Mutex) {
        var result = winapi.release_mutex(mutex);
        if result == 0 {
            println("failed to unlock mutex");
        }
    }

    pub func mutex_destroy(mutex: Mutex) {
        winapi.close_handle(mutex);
    }

    pub func time_system_ticks() -> u64 {
        var time: winapi.Filetime;
        winapi.get_system_time_as_file_time(&time);
        return time.low_date_time as u64 | (time.high_date_time as u64 << 32);
    }

    pub func time_system_frequency() -> u64 {
        return 10000000;
    }

    pub func time_system_ticks_since_unix_epoch() -> u64 {
        return 116444736000000000;
    }

    pub func time_monotonic_ticks() -> u64 {
        var counter: u64;
        winapi.query_performance_counter(&counter);
        return counter;
    }

    pub func time_monotonic_frequency() -> u64 {
        var frequency: u64;
        winapi.query_performance_frequency(&frequency);
        return frequency;
    }

    pub func socket_create(address_family: i32, socket_type: i32, protocol: i32) -> Socket {
        if !wsa_initialized {
            var wsa_version: u16 = 514;  # MAKEWORD(2, 2)
            var wsa_data: [u8; 512] = undefined;
            winapi.wsa_startup(wsa_version, &wsa_data);

            wsa_initialized = true;
        }

        return winapi.socket(address_family, socket_type, protocol);
    }

    pub func socket_set_blocking(socket: Socket, blocking: bool) {
        var value: u32;

        if blocking {
            value = 0;
        } else {
            value = 1;
        }

        winapi.ioctlsocket(socket, winapi.FIONBIO, &value);
    }

    pub func socket_connect(socket: Socket, host: String, port: u32) -> bool {
        var result: i32;

        var addr_hints = winapi.Addrinfo {
            flags: 0,
            family: 0,
            socktype: 0,
            protocol: 0,
            addrlen: 0,
            canonname: null,
            addr_: null,
            next: null,
        };

        var host_cstring = host.to_cstring();
        var port_cstring = to_string(port).to_cstring();

        var addr_info: *winapi.Addrinfo;
        result = winapi.getaddrinfo(host_cstring.data(), port_cstring.data(), &addr_hints, &addr_info);
        if result != 0 {
            return false;
        }

        result = winapi.connect(socket, addr_info.addr_, addr_info.addrlen as i32);
        winapi.freeaddrinfo(addr_info);
        return result == 0;
    }

    pub func socket_send(socket: Socket, buffer: *u8, size: usize) -> usize except ErrorCode {
        var result = winapi.send(socket, buffer, size as i32, 0);
        if result >= 0 {
            return result as usize;
        } else {
            return error_last();
        }
    }

    pub func socket_recv(socket: Socket, buffer: *u8, size: usize) -> usize except ErrorCode {
        var result = winapi.recv(socket, buffer, size as i32, 0);
        if result >= 0 {
            return result as usize;
        } else {
            return error_last();
        }
    }

    pub func socket_close(socket: Socket) {
        winapi.shutdown(socket, winapi.SD_BOTH);
        winapi.closesocket(socket);
    }

    pub func exec_debug_section() -> ?Slice[u8] {
        return none;
    }

    func read_file(handle: winapi.Handle, data: Slice[u8]) -> usize except ErrorCode {
        var bytes_read: winapi.Dword = undefined;

        var result = winapi.read_file(
            handle,
            data.data,
            data.length as winapi.Dword,
            &bytes_read,
            null,
        );

        if result != 0 {
            return bytes_read as usize;
        } else {
            return error_last();
        }
    }

    func write_file(handle: winapi.Handle, data: Slice[u8]) -> usize except ErrorCode {
        var bytes_written: winapi.Dword = undefined;

        var result = winapi.write_file(
            handle,
            data.data,
            data.length as winapi.Dword,
            &bytes_written,
            null,
        );

        if result != 0 {
            return bytes_written as usize;
        } else {
            return error_last();
        }
    }

    func read_console_utf16(handle: winapi.Handle, data: Slice[u16]) -> usize except ErrorCode {
        var utf16_values_read: winapi.Dword = undefined;

        var result = winapi.read_console(
            handle,
            data.data(),
            data.length() as winapi.Dword,
            &utf16_values_read,
            null,
        );

        if result != 0 {
            return utf16_values_read as usize;
        } else {
            return error_last();
        }
    }

    func write_console_utf16(handle: winapi.Handle, data: Slice[u16]) -> usize except ErrorCode {
        var utf16_values_written: winapi.Dword = undefined;

        var result = winapi.write_console(
            handle,
            data.data(),
            data.length() as winapi.Dword,
            &utf16_values_written,
            null,
        );

        if result != 0 {
            return utf16_values_written as usize;
        } else {
            return error_last();
        }
    }

    func is_console(handle: winapi.Handle) -> bool {
        var console_mode: winapi.Dword = undefined;
        return winapi.get_console_mode(handle, &console_mode) != 0;
    }
}
