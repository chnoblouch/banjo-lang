use std.config;

meta if config.ARCH != config.WASM {
    native var __bnjdbg_start: u64;
    native var __bnjdbg_end: u64;
}

struct DebugInfo {
    var slice: Slice[u8];

    pub func load() -> ?DebugInfo {
        meta if config.ARCH != config.WASM {
            var pointer = &__bnjdbg_start as *u8;
            var size = &__bnjdbg_end as usize - &__bnjdbg_start as usize;

            return DebugInfo { slice: Slice[u8].new(pointer, size) };
        } else {
            return none;
        }
    }

    pub func symbol_name(self, address: addr) -> ?StringSlice {
        var slice = self.slice;

        var num_functions = *(&slice[0] as *u64);
        var function_index: ?usize = none;

        for i in 0..num_functions as usize {
            var current = *(&slice[8 + 16 * i] as *u64);

            if current <= address as u64 {
                function_index = i;
            } else {
                break;
            }
        }

        try index in function_index {
            var name_offset = *(&slice[8 + 16 * index + 8] as *u64);
            var pointer = &slice[name_offset as usize] as *u8;
            return StringSlice.of_cstring(pointer);
        } else {
            return none;
        }
    }
}
