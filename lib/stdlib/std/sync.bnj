use std.platform;

struct Mutex[T] {
    var handle: platform.Mutex;
    var value: T;

    pub func new(value: T) -> Mutex[T] {
        return Mutex[T] {
            handle: platform.mutex_create(),
            value,
        };
    }

    pub func lock(mut self) -> Lock[T] {
        platform.mutex_lock(self.handle);

        return Lock[T] {
            handle: self.handle,
            value: ref mut self.value,
        };
    }
}

struct Lock[T] {
    var handle: platform.Mutex;
    var value: ref mut T;

    pub func __deinit__(self) {
        platform.mutex_unlock(self.handle);
    }
}

struct Condition {
    var handle: platform.Condition;

    pub func new() -> Condition {
        return Condition { handle: platform.condition_create() };
    }

    pub func notify_one(self) {
        platform.condition_notify_one(self.handle);
    }

    pub func notify_all(self) {
        platform.condition_notify_all(self.handle);
    }

    pub func wait[T](self, lock: ref Lock[T]) {
        platform.condition_wait(self.handle, lock.handle);
    }

    pub func __deinit__(self) {
        platform.condition_destroy(self.handle);
    }
}

struct Channel[T] {
    var values: Mutex[Array[T]];
    var buffer_size: usize;
    var updated: Condition;

    pub func new() -> Channel[T] {
        return Channel[T] {
            values: Mutex[Array[T]].new([]),
            buffer_size: 1,
            updated: Condition.new(),
        };
    }

    pub func buffered(size: usize) -> Channel[T] {
        return Channel[T] {
            values: Mutex[Array[T]].new([]),
            buffer_size: size,
            updated: Condition.new(),
        };
    }

    pub func pull(mut self) -> T {
        var lock = self.values.lock();

        while lock.value.length() == 0 {
            self.updated.wait(ref lock);
        }

        var value = lock.value.remove(0);
        self.updated.notify_all();
        return value;
    }

    pub func push(mut self, value: T) {
        var lock = self.values.lock();

        while lock.value.length() == self.buffer_size {
            self.updated.wait(ref lock);
        }

        lock.value.append(value);
        self.updated.notify_all();
    }
}
