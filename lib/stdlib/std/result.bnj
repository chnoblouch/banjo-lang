use std.{convert.to_string, protos.ToString};
use internal.std_panics.{panic_unwrap_result, panic_unwrap_error_result};

struct Result[T, E]: ToString {
    var successful: bool;

    @unmanaged
    var value: T;

    @unmanaged
    var error: E;

    pub func new_success(value: T) -> Result[T, E] {
        return Result[T, E] {
            successful: true,
            value,
            error: undefined,
        };
    }

    pub func new_failure(error: E) -> Result[T, E] {
        return Result[T, E] {
            successful: false,
            value: undefined,
            error,
        };
    }

    pub func unwrap(@unmanaged move self) -> T {
        if !self.successful {
            panic_unwrap_result(self.error);
        }

        return self.value;
    }

    pub func unwrap_error(@unmanaged move self) -> E {
        if self.successful {
            panic_unwrap_error_result();
        }

        return self.error;
    }

    pub func as_ref(mut self) -> Result[*T, *E] {
        if self.successful {
            return Result[*T, *E].new_success(&self.value);
        } else {
            return Result[*T, *E].new_failure(&self.error);
        }
    }

    pub func __str__(self) -> String {
        if self.successful {
            return to_string(self.value);
        } else {
            return to_string(self.error);
        }
    }

    pub func __deinit__(self) {
        if self.successful {
            __builtin_deinit(self.value);
        } else {
            __builtin_deinit(self.error);
        }
    }
}
